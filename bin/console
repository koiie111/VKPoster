#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Kernel\Application;
use App\Kernel\Console\Command\AuthPruneCommand;
use App\Kernel\Console\Command\BenchPublishCommand;
use App\Kernel\Console\Command\ChannelsCheckCommand;
use App\Kernel\Console\Command\CreateAdminCommand;
use App\Kernel\Console\Command\CryptoRotateCommand;
use App\Kernel\Console\Command\KeyGenerateCommand;
use App\Kernel\Console\Command\MigrateCommand;
use App\Kernel\Console\Command\MigrateFreshCommand;
use App\Kernel\Console\Command\MigrateRollbackCommand;
use App\Kernel\Console\Command\MigrateStatusCommand;
use App\Kernel\Console\Command\QueueWorkCommand;
use App\Kernel\Console\Command\ScheduleRunCommand;
use App\Kernel\Console\Command\SeedCommand;
use App\Kernel\Console\Command\TelegramPollCommand;
use App\Kernel\Console\Command\TelegramWebhookCommand;
use App\Kernel\Console\Console;
use App\Kernel\Console\Output;

require dirname(__DIR__) . '/vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}

try {
    $app = Application::create(dirname(__DIR__));
    $console = new Console($app->container(), [
        MigrateCommand::class,
        MigrateRollbackCommand::class,
        MigrateStatusCommand::class,
        MigrateFreshCommand::class,
        SeedCommand::class,
        QueueWorkCommand::class,
        ScheduleRunCommand::class,
        KeyGenerateCommand::class,
        CreateAdminCommand::class,
        AuthPruneCommand::class,
        BenchPublishCommand::class,
        ChannelsCheckCommand::class,
        CryptoRotateCommand::class,
        TelegramPollCommand::class,
        TelegramWebhookCommand::class,
    ]);
} catch (Throwable $e) {
    fwrite(STDERR, 'Cannot start: ' . $e->getMessage() . "\n");
    exit(1);
}

exit($console->run($argv, Output::stdout()));
