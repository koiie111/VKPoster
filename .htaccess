Options -Indexes
ServerSignature Off

# Не отдаём служебные файлы и исходники напрямую
RedirectMatch 404 ^/(\.git|system|vendor|docker)(/|$)
RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 \.(sql|lock|json|md|yml|yaml|dist|env)$
RedirectMatch 404 ^/(Dockerfile|LICENSE)$

RewriteEngine On
RewriteRule ^auth$ /modules/auth/auth.php [L]
RewriteRule ^auth_callback$ /modules/auth/auth_callback.php [L]

RewriteRule ^main$ /modules/main/user_status.php [L]
RewriteRule ^main/groups$ /modules/main/groups.php [L]
RewriteRule ^dev_login$ /modules/auth/dev_login.php [L]
