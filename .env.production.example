# Production settings: copy to `.env` on the server (never commit it) and fill in every value. See docs/deploy.md.
APP_ENV=production
APP_URL=https://example.com           # the public https address (the session cookie becomes Secure, links in emails use it)
APP_NAME=ezposter
APP_DEBUG=0
# No APP_KEY / APP_KEYS / local pepper in a normal production PHP process.
CRYPTO_BACKEND=vault
VAULT_TRANSIT_URL=https://crypto.internal.example:8200
VAULT_TRANSIT_KEY=vkposter
VAULT_TOKEN_FILE=/run/secrets/transit-app.token
VAULT_CA_FILE=/run/secrets/transit-ca.pem
VAULT_APP_TOKEN_HOST_PATH=/etc/ezposter/transit-app.token
VAULT_PDF_TOKEN_HOST_PATH=/etc/ezposter/transit-pdf.token
VAULT_CA_HOST_PATH=/etc/ezposter/transit-ca.pem
# Non-authority telemetry salt, not an encryption/signing key; independent from all crypto identities.
EGRESS_IDENTITY_SALT=
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1   # the reverse proxy in front of nginx (otherwise every visitor shares one IP for rate limits)
HTTP_PORT=8080                        # nginx listens on 127.0.0.1:HTTP_PORT; the reverse proxy forwards to it
LOG_LEVEL=info

DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=                          # long random value
DB_ROOT_PASSWORD=                     # another long random value

MAIL_DSN=                             # smtp://user:password@smtp.provider.example:587
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=ezposter
SUPPORT_EMAIL=support@example.com     # the mailbox for "Сообщить о проблеме"

PLATFORMS_ENABLED=telegram,vk,max
BILLING_GATEWAYS=yookassa,tbank
# Keys of the platforms and payment providers (see .env.example for the full list and what each one is):
# TELEGRAM_BOT_TOKEN= TELEGRAM_WEBHOOK_SECRET= VK_CLIENT_ID= MAX_BOT_TOKEN= MAX_WEBHOOK_SECRET=
# YOOKASSA_SHOP_ID= YOOKASSA_SECRET_KEY= TBANK_TERMINAL_KEY= TBANK_PASSWORD=
# BILLING_TAX_SYSTEM=npd BILLING_SELLER_NAME= BILLING_SELLER_INN=

# Stage 15: opt-in collector, separate analytics-worker; renderer key is derived automatically in PHP.
ANALYTICS_COLLECTION_ENABLED=false
ANALYTICS_PDF_URL=http://analytics-pdf:3000

# Outgoing webhook delivery protection and completed-event history (minimum retention 35 days).
WEBHOOK_FAILURE_LIMIT=10
WEBHOOK_RETENTION_DAYS=35

# Production Compose image references (CD not yet enabled in Stage 19A).
APP_IMAGE=ezposter-app:prod
WEB_IMAGE=ezposter-web:prod

# Required in production; owner provisions separately in 19.8. Empty for the existing local Redis.
REDIS_PASSWORD=

# Stage 19 operations: disabled until configured by owner in 19.8.
OPS_MONITOR_ENABLED=false
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
SENTRY_DSN=
OPS_IMAGE=ezposter-ops:prod
PDF_IMAGE=ezposter-pdf:prod
BACKUP_KEY_FILE=
BACKUP_KEY_HOST_PATH=/etc/ezposter/backup.key
BACKUP_DIRECTORY=/var/backups/ezposter
BACKUP_RETENTION_DAYS=30
# Per Oracle dump/restore process, 1..86400 seconds. Increase systemd total budget if raised.
BACKUP_PROCESS_TIMEOUT=1800
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
RESTORE_DB_HOST=
RESTORE_DB_PORT=3306
RESTORE_DB_USERNAME=
RESTORE_DB_PASSWORD=

# PITR preparation: a separately provisioned backup account, never the web app account.
BACKUP_BINLOG_ENABLED=false
BACKUP_BINLOG_DIRECTORY=/mysql-binlog
BACKUP_MYSQL_GID=999
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_BINLOG_ROTATE=false

# Local backup socket; restore socket must point only to the isolated target.
BACKUP_DB_SOCKET=
RESTORE_DB_SOCKET=

# Stage 19.2.5: provider-scoped routes, direct by default. No global server VPN.
EGRESS_PROBE_ENABLED=false
EGRESS_REQUIRED_PROVIDERS=
EGRESS_TELEGRAM_MODE=direct
EGRESS_TELEGRAM_PROXY_URL=
EGRESS_VK_MODE=direct
EGRESS_VK_PROXY_URL=
EGRESS_MAX_MODE=direct
EGRESS_MAX_PROXY_URL=
EGRESS_OPENAI_MODE=direct
EGRESS_OPENAI_PROXY_URL=
EGRESS_TINEYE_MODE=direct
EGRESS_TINEYE_PROXY_URL=
EGRESS_REPLICATE_MODE=direct
EGRESS_REPLICATE_PROXY_URL=
EGRESS_ANTHROPIC_MODE=direct
EGRESS_ANTHROPIC_PROXY_URL=
EGRESS_GLITCHTIP_MODE=direct
EGRESS_GLITCHTIP_PROXY_URL=

# Password pepper and PDF HMAC are non-exportable Transit purposes, not local key files.
# VAULT_LEGACY_TRANSIT_KEY is optional read-only migration from the earlier v2 format.
VAULT_LEGACY_TRANSIT_KEY=

# Production must use clamd; fake is dev/test only. Private scanner, never Internet TCP.
MALWARE_SCANNER=clamd
CLAMD_ENDPOINT=tcp://clamav:3310

# Built with security-patched distro packages; publish immutable image digest during release.
REDIS_IMAGE=ezposter-redis:prod

# Build docker/mysql target server; release deploy uses immutable GHCR version reference.
MYSQL_IMAGE=ezposter-mysql:prod

# Verify-only compatibility for pre-Transit signed links; imported offline, bounded by last legacy TTL.
VAULT_LEGACY_SIGNER_KEY=
# UTC Unix timestamp; 0 disables legacy verification. No raw signing key in PHP.
VAULT_LEGACY_SIGNER_UNTIL=0
# Required CA path inside the ops container for any production TCP backup/restore/rotation.
# Default production backup uses a local Unix socket; remote restore must mount its target CA read-only.
OPERATIONS_DB_TLS_CA_FILE=
