{
    "name": "vkposter/app",
    "description": "Scheduled posting service for VK, MAX, Telegram and Instagram (plain PHP).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^8.2",
        "monolog/monolog": "^3.12",
        "php": "^8.3",
        "symfony/uid": "^7.4",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tools\\PHPStan\\": "tools/phpstan/"
        },
        "classmap": [
            "tests/PHPStan/data"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
