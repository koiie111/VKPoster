# Copy to .env via `make init` (it also generates APP_KEY). Never commit .env.
APP_ENV=local            # local | testing | production
APP_URL=http://localhost:8080
APP_NAME=ezposter
APP_DEBUG=0              # never 1 in production (the app refuses to boot)
APP_KEY=                 # base64 libsodium secretbox key, generated by `make init`
APP_KEY_ID=k1            # id written into ciphertexts made with APP_KEY
APP_KEYS=                # old keys kept for decryption after rotation: id:base64,id:base64
ADMIN_IP_ALLOWLIST=      # optional: comma-separated IPs/CIDRs; when set, /admin answers 404 to everybody else
TRUSTED_PROXIES=         # comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted
APP_VERSION=             # what is deployed, shown in the admin system page (set by the deploy)
APP_DEPLOYED_AT=         # UTC time of the deploy, e.g. 2026-10-05T12:00:00Z
LOG_LEVEL=info           # debug | info | notice | warning | error | critical

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

SESSION_IDLE_TTL=7200          # seconds of inactivity before a session ends
SESSION_ABSOLUTE_TTL=2592000    # hard session lifetime (30 days)

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0               # tests use db 15 so they never touch dev sessions

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=ezposter
SUPPORT_EMAIL=support@localhost  # mailbox that receives "Сообщить о проблеме" messages (and is shown to users)
MAIL_DSN=                # optional, wins over MAIL_HOST/PORT: smtp://user:pass@smtp.example.com:587

# Sign-in (stage 02)
DEV_LOGIN=1              # /dev/login-as/{id|email}; works only with APP_ENV=local, forbidden in production
PASSWORD_HIBP=0          # 1 = reject passwords found in Have I Been Pwned (k-anonymity range API)
REMEMBER_DAYS=30         # lifetime of the "remember me" cookie

# Optional S3 storage (profile `s3`)
S3_KEY=minioadmin
S3_SECRET=minioadmin

# Media library (stage 05)
MEDIA_DISK=local         # local = storage/media, s3 = S3-compatible bucket (fill S3_* below; for MinIO: docker compose --profile s3 up -d)
MEDIA_LOCAL_ROOT=storage/media
S3_ENDPOINT=             # MinIO: http://minio:9000 ; empty = AWS
S3_BUCKET=ezposter
S3_REGION=us-east-1
S3_PATH_STYLE=1
MEDIA_MAX_FILE_MB=50     # keep <= upload_max_filesize (php.ini) and client_max_body_size (nginx)
MEDIA_QUOTA_MB=0         # optional global cap on the library size (0 = none); the plan decides the size
MEDIA_MAX_VIDEO_SECONDS=900
MEDIA_URL_TIMEOUT=30     # seconds for "upload by link"
MEDIA_SIGNED_URL_TTL=3600

# Social sign-in (stage 03). A provider without keys is hidden. Redirect URI for every provider: ${APP_URL}/auth/{vkid|yandex|google}/callback
VKID_CLIENT_ID=          # id.vk.com -> business cabinet -> application
VKID_CLIENT_SECRET=      # protected key (optional for the PKCE flow)
YANDEX_CLIENT_ID=        # oauth.yandex.ru, scopes login:email login:info
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=        # Google Cloud Console -> OAuth client (Web)
GOOGLE_CLIENT_SECRET=
TELEGRAM_LOGIN_BOT_TOKEN=  # bot created in @BotFather; run /setdomain with the public domain
TELEGRAM_LOGIN_BOT_NAME=   # bot username without @
OAUTH_ORDER=vkid,yandex,telegram,google  # order of the buttons on the sign-in page
DEV_OAUTH_FAKE=0         # 1 = built-in fake provider at /dev/oauth/fake (APP_ENV=local only, forbidden in production)

# Channels and platforms (stage 06)
PLATFORMS_ENABLED=telegram   # comma-separated feature flags: telegram,vk,max,instagram; `fake` (a test network) works only outside production
VK_CLIENT_ID=                # VK ID application used to publish to communities (empty: VKID_CLIENT_ID is used)
VK_CLIENT_SECRET=            # its protected key (empty: VKID_CLIENT_SECRET)
# Rights asked from the VK account. Switch the network on with PLATFORMS_ENABLED=telegram,vk
VK_SCOPE="wall photos video docs groups"
VK_POSTS_PER_DAY=50          # daily post limit of one community, used for the warning in the editor
# Instagram (ADR 0010): off by default. Switch on with PLATFORMS_ENABLED=telegram,instagram. Needs APP_URL reachable from the internet over https
# (Instagram downloads the files itself; locally use the `tunnel` profile) and the redirect URL APP_URL/channels/connect/instagram/callback in the Meta app.
INSTAGRAM_APP_ID=            # Meta app: Instagram API with Instagram Login
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPE="instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments"
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_POSTS_PER_DAY=100  # daily API publication limit of one account, used for the warning in the editor
TELEGRAM_BOT_TOKEN=          # shared bot every customer adds to their channels: create it in @BotFather
TELEGRAM_BOT_USERNAME=       # bot username without @ (optional: asked from Telegram when empty)
TELEGRAM_WEBHOOK_SECRET=     # 16-128 chars A-Za-z0-9_- ; part of the webhook URL. Then: make console CMD="telegram:webhook set https://your-public-host"
MAX_BOT_TOKEN=               # shared MAX bot (needs a verified Russian legal entity): create it at business.max.ru. Switch on with PLATFORMS_ENABLED=telegram,vk,max
MAX_BOT_USERNAME=            # bot username without @ (optional: asked from MAX when empty)
MAX_WEBHOOK_SECRET=          # 16-128 chars A-Za-z0-9_- ; part of the webhook URL. Then: make console CMD="max:webhook set https://your-public-host"
MAX_API_BASE=https://platform-api2.max.ru
MAX_CA_FILE=resources/certs/russian-trusted-root-ca.pem   # trust anchor for the MAX API only (its certificate is issued by the Russian Trusted CA); empty = system store
CHANNELS_MAX=1000            # global ceiling of channels per workspace (paused included); the plan's own limit counts active ones
CHANNEL_PREFLIGHT_MINUTES=15 # a channel is re-checked right before publishing when its last check is older than this

# Billing (stage 10)
BILLING_GATEWAYS=yookassa,tbank   # offered at checkout; `fake` (test payment page) is added automatically outside production
YOOKASSA_SHOP_ID=                 # test or live shop id from the YooKassa cabinet
YOOKASSA_SECRET_KEY=              # its secret key (never commit). Notifications: <APP_URL>/webhooks/billing/yookassa
YOOKASSA_VERIFY_IP=1              # check the sender address of notifications; 0 only outside production (a tunnel)
TBANK_TERMINAL_KEY=               # T-Bank acquiring terminal
TBANK_PASSWORD=                   # its password (signs requests). Notifications: <APP_URL>/webhooks/billing/tbank
# Payment providers are switched on and given keys in the admin area (/admin/providers, super-admin only); a saved value wins over these.
# They only seed a fresh install. BILLING_GATEWAYS lists the providers that are on until the admin area decides otherwise.
CLOUDPAYMENTS_PUBLIC_ID=          # CloudPayments site Public ID. Notifications: <APP_URL>/webhooks/billing/cloudpayments?type=pay (also fail, refund)
CLOUDPAYMENTS_API_SECRET=         # its "Пароль для API" (signs notifications and requests)
STRIPE_SECRET_KEY=                # Stripe sk_test_… / sk_live_…. Notifications: <APP_URL>/webhooks/billing/stripe
STRIPE_WEBHOOK_SECRET=            # whsec_… of that webhook endpoint
PADDLE_API_KEY=                   # Paddle Billing API key. Notifications: <APP_URL>/webhooks/billing/paddle
PADDLE_WEBHOOK_SECRET=            # notification destination secret
PADDLE_SANDBOX=                   # 1 = sandbox-api.paddle.com
CRYPTO_MERCHANT_ID=               # Heleket merchant UUID. Notifications: <APP_URL>/webhooks/billing/crypto
CRYPTO_API_KEY=                   # Heleket payment API key
BILLING_TAX_SYSTEM=npd            # npd (self-employed: no receipt sent to the provider) | osn | usn_income | usn_income_outcome | patent | envd | esn
BILLING_VAT=none                  # for receipts: none | vat0 | vat10 | vat20 | vat22
BILLING_SELLER_NAME=              # printed on the receipt, e.g. "ИП Иванов И. И."
BILLING_SELLER_INN=               # tax number printed on the receipt

# The Sources / trend radar feature is off until the owner has decided the stage 23 questions (ADR 0011).
SOURCES_ENABLED=false
# Dedicated internal reader bearer secret (32+ random characters); empty disables API.
SOURCES_READER_SECRET=

# Stage 3.2 real content providers: explicit opt-in; keys only in ignored local .env.
CONTENT_TEXT_PROVIDER=fake
CONTENT_SEMANTIC_PROVIDER=fake
CONTENT_IMAGE_SEARCH_PROVIDER=fake
CONTENT_IMAGE_ENHANCEMENT_PROVIDER=fake
CONTENT_VIDEO_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.4-mini-2026-03-17
TINEYE_API_KEY=
REPLICATE_API_TOKEN=

# Content hardening: costly HTTP fails closed if Redis limits are unavailable.
CONTENT_CONCURRENCY=2
CONTENT_PROVIDER_PER_MINUTE=20
CONTENT_WORKSPACE_PER_MINUTE=5
CONTENT_VIDEO_PER_HOUR=3
CONTENT_VIDEO_PENDING=3
CONTENT_RETENTION_ENABLED=false
CONTENT_RETENTION_DAYS=30
CONTENT_STUCK_SECONDS=3600

# AI assistant in the editor (stage 17). Providers and keys are set in the admin area (/admin/ai), not here.
# AI_FAKE: without a connected provider the assistant answers with the offline test model; never in production.
AI_FAKE=true
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=1024
AI_WORKSPACE_PER_MINUTE=10
AI_TIMEOUT_SECONDS=60

# Renderer receives only a domain-separated key file; no new secret to configure.
# Optional isolated report renderer: docker compose --profile analytics up -d analytics-pdf
ANALYTICS_PDF_URL=http://analytics-pdf:3000
ANALYTICS_COLLECTION_ENABLED=false

# Links in posts (stage 17). UTM tags and the switch for short links are set per workspace on /w/<id>/settings/links.
# SHORT_LINK_DOMAIN: host that serves https://<domain>/<code> redirects (point it to this app); empty = APP_URL/s/<code>.
SHORT_LINK_DOMAIN=
SHORT_LINK_MANUAL_PER_DAY=100
SHORT_LINK_CLICK_RETENTION_DAYS=400

# Outgoing webhook delivery protection and completed-event history (minimum retention 35 days).
WEBHOOK_FAILURE_LIMIT=10
WEBHOOK_RETENTION_DAYS=35

# Production Compose image references (CD not yet enabled in Stage 19A).
APP_IMAGE=ezposter-app:prod
WEB_IMAGE=ezposter-web:prod

# Required in production; owner provisions separately in 19.8. Empty for the existing local Redis.
REDIS_PASSWORD=

# Stage 19 operations: disabled until configured by owner in 19.8.
OPS_MONITOR_ENABLED=false
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
SENTRY_DSN=
OPS_IMAGE=ezposter-ops:prod
PDF_IMAGE=ezposter-pdf:prod
BACKUP_KEY_FILE=
BACKUP_KEY_HOST_PATH=/etc/ezposter/backup.key
BACKUP_DIRECTORY=/var/backups/ezposter
BACKUP_RETENTION_DAYS=30
# Per Oracle dump/restore process, 1..86400 seconds. Increase systemd total budget if raised.
BACKUP_PROCESS_TIMEOUT=1800
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
RESTORE_DB_HOST=
RESTORE_DB_PORT=3306
RESTORE_DB_USERNAME=
RESTORE_DB_PASSWORD=

# PITR preparation: a separately provisioned backup account, never the web app account.
BACKUP_BINLOG_ENABLED=false
BACKUP_BINLOG_DIRECTORY=/mysql-binlog
BACKUP_MYSQL_GID=999
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_BINLOG_ROTATE=false

# Local backup socket; restore socket must point only to the isolated target.
BACKUP_DB_SOCKET=
RESTORE_DB_SOCKET=

# Stage 19.2.5: provider-scoped routes, direct by default. No global server VPN.
EGRESS_PROBE_ENABLED=false
EGRESS_REQUIRED_PROVIDERS=
EGRESS_TELEGRAM_MODE=direct
EGRESS_TELEGRAM_PROXY_URL=
EGRESS_VK_MODE=direct
EGRESS_VK_PROXY_URL=
EGRESS_MAX_MODE=direct
EGRESS_MAX_PROXY_URL=
EGRESS_OPENAI_MODE=direct
EGRESS_OPENAI_PROXY_URL=
EGRESS_TINEYE_MODE=direct
EGRESS_TINEYE_PROXY_URL=
EGRESS_REPLICATE_MODE=direct
EGRESS_REPLICATE_PROXY_URL=
EGRESS_ANTHROPIC_MODE=direct
EGRESS_ANTHROPIC_PROXY_URL=
EGRESS_GLITCHTIP_MODE=direct
EGRESS_GLITCHTIP_PROXY_URL=

# Optional legacy local/testing pepper file. Production rejects local pepper files and uses Transit.
PASSWORD_PEPPER_FILE=
PASSWORD_PEPPER_ID=p1
PASSWORD_PEPPER_PREVIOUS_FILES=

# Legacy local/testing mount only; never mount this raw pepper in a normal production app.
PASSWORD_PEPPER_HOST_PATH=/etc/ezposter/password-pepper.key

# External non-exportable key operations. No silent fallback if Vault is selected.
CRYPTO_BACKEND=sodium
VAULT_TRANSIT_URL=
VAULT_TRANSIT_KEY=vkposter
VAULT_TOKEN_FILE=
VAULT_CA_FILE=

# Production must use clamd; fake is dev/test only. Private scanner, never Internet TCP.
MALWARE_SCANNER=fake
CLAMD_ENDPOINT=tcp://clamav:3310

# Isolated production crypto (OpenBao-compatible Transit); local/test default remains sodium.
# Production must not define APP_KEY/APP_KEYS/local pepper files.
VAULT_LEGACY_TRANSIT_KEY=
VAULT_APP_TOKEN_HOST_PATH=/etc/ezposter/transit-app.token
VAULT_PDF_TOKEN_HOST_PATH=/etc/ezposter/transit-pdf.token
VAULT_CA_HOST_PATH=/etc/ezposter/transit-ca.pem
# Non-authority route fingerprint salt, independent from master keys.
EGRESS_IDENTITY_SALT=

# Verify-only compatibility for pre-Transit signed links; imported offline, bounded by last legacy TTL.
VAULT_LEGACY_SIGNER_KEY=
# UTC Unix timestamp; 0 disables legacy verification. No raw signing key in PHP.
VAULT_LEGACY_SIGNER_UNTIL=0
# Required CA path inside the ops container for any production TCP backup/restore/rotation.
# Default production backup uses a local Unix socket; remote restore must mount its target CA read-only.
OPERATIONS_DB_TLS_CA_FILE=
