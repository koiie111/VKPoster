# Copy to .env via `make init` (it also generates APP_KEY). Never commit .env.
APP_ENV=local            # local | testing | production
APP_URL=http://localhost:8080
APP_NAME=ezposter
APP_DEBUG=0              # never 1 in production (the app refuses to boot)
APP_KEY=                 # base64 libsodium secretbox key, generated by `make init`
APP_KEY_ID=k1            # id written into ciphertexts made with APP_KEY
APP_KEYS=                # old keys kept for decryption after rotation: id:base64,id:base64
TRUSTED_PROXIES=         # comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted
LOG_LEVEL=info           # debug | info | notice | warning | error | critical

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root

SESSION_IDLE_TTL=7200          # seconds of inactivity before a session ends
SESSION_ABSOLUTE_TTL=2592000    # hard session lifetime (30 days)

REDIS_HOST=redis
REDIS_PORT=6379

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=ezposter

# Optional S3 storage (profile `s3`)
S3_KEY=minioadmin
S3_SECRET=minioadmin
