{#- Social sign-in. `social` = {buttons: [{id, label, href}], telegram: {bot, auth_url}|null}; see App\Http\Auth\SocialFlow. -#}

{#- Divider with a caption, used between the form and the social buttons. -#}
{% macro divider(text = 'или') -%}
<div class="my-6 flex items-center gap-3 text-sm text-muted" role="separator" aria-label="{{ text }}">
    <span class="h-px flex-1 bg-line"></span><span>{{ text }}</span><span class="h-px flex-1 bg-line"></span>
</div>
{%- endmacro %}

{#- Buttons "Войти через …". Telegram is the official widget when `social.telegram` is set; otherwise it is a link to the sign-in page. -#}
{% macro sign_in_buttons(social, verb = 'Войти через') -%}
{% import 'components/forms.twig' as f %}
{%- if social.buttons|length %}
<div class="flex flex-col gap-3" data-social-buttons>
    {%- for b in social.buttons %}
        {%- if b.id == 'telegram' %}
            {%- if social.telegram %}
            <div class="flex min-h-11 items-center justify-center" id="telegram-login">
                <script async src="https://telegram.org/js/telegram-widget.js?22" data-telegram-login="{{ social.telegram.bot }}" data-size="large" data-radius="12" data-userpic="false" data-auth-url="{{ social.telegram.auth_url }}"></script>
            </div>
            {%- else %}
            {{ f.button(verb ~ ' Telegram', variant = 'secondary', href = url('login') ~ '#telegram-login', block = true) }}
            {%- endif %}
        {%- else %}
            {{ f.button(verb ~ ' ' ~ b.label, variant = 'secondary', href = b.href, block = true) }}
        {%- endif %}
    {%- endfor %}
</div>
{%- endif %}
{%- endmacro %}
