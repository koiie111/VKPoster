{#- Calendar views over plain arrays. Items: {platform, time, title, status}. -#}

{% macro item(it, href = '#') -%}
<li><a class="plat plat-{{ it.platform }} flex min-h-7 items-center gap-1.5 truncate rounded-sm border border-line bg-surface px-2 py-1 text-xs font-medium shadow-card hover:bg-sunken{{ it.status == 'failed' ? ' !border-bad text-bad-fg' : '' }}" href="{{ href }}"><span class="shrink-0 tabular-nums">{{ it.time }}</span><span class="truncate">{{ it.title }}</span></a></li>
{%- endmacro %}

{#- days: list of {label, num, today?, items}. Seven columns from md, a stacked list below. -#}
{% macro week(days) -%}
{% import _self as c %}
<div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
    <div class="grid lg:grid-cols-7">
        {% for day in days %}
        <div class="min-w-0 border-line p-2 max-lg:border-t first:max-lg:border-t-0 lg:min-h-40 lg:border-l first:lg:border-l-0 {{ day.today is defined and day.today ? 'bg-primary-soft' : '' }}">
            <div class="mb-2 flex items-baseline gap-1.5 text-sm"><span class="font-semibold">{{ day.label }}</span><span class="text-muted">{{ day.num }}</span></div>
            <ul class="flex flex-col gap-1.5">
                {% for it in day.items %}{{ c.item(it) }}{% else %}<li class="text-xs text-muted">Нет постов</li>{% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>
</div>
{%- endmacro %}

{#- weeks: list of 7-cell lists {num, other?, today?, items}. Small screens show colored dots instead of chips. -#}
{% macro month(weeks) -%}
{% import _self as c %}
<div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
    <div class="grid grid-cols-7 border-b border-line bg-sunken/50 text-center text-xs font-semibold text-muted" aria-hidden="true">
        {% for d in ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'] %}<div class="py-2">{{ d }}</div>{% endfor %}
    </div>
    {% for week in weeks %}
    <div class="grid grid-cols-7 {{ not loop.first ? 'border-t border-line' : '' }}">
        {% for cell in week %}
        <div class="min-h-16 min-w-0 p-1 md:min-h-28 md:p-2 {{ not loop.first ? 'border-l border-line' : '' }} {{ cell.other is defined and cell.other ? 'bg-sunken/40 text-muted' : '' }}">
            <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full text-xs font-semibold {{ cell.today is defined and cell.today ? 'bg-primary text-primary-fg' : '' }}">{{ cell.num }}</span>
            <ul class="mt-1 hidden flex-col gap-1 md:flex">
                {% for it in cell.items|slice(0, 2) %}{{ c.item(it) }}{% endfor %}
                {% if cell.items|length > 2 %}<li class="px-1 text-xs text-muted">ещё {{ cell.items|length - 2 }}</li>{% endif %}
            </ul>
            {% if cell.items %}<div class="mt-1 flex flex-wrap gap-0.5 md:hidden" role="img" aria-label="Постов: {{ cell.items|length }}">{% for it in cell.items %}<span class="plat plat-{{ it.platform }} inline-flex"></span>{% endfor %}</div>{% endif %}
        </div>
        {% endfor %}
    </div>
    {% endfor %}
</div>
{%- endmacro %}

{#- groups: list of {label, items}. -#}
{% macro list(groups) -%}
{% import _self as c %}
{% import 'components/display.twig' as d %}
<div class="flex flex-col gap-5">
    {% for g in groups %}
    <section aria-label="{{ g.label }}">
        <h3 class="mb-2 text-sm font-semibold text-muted">{{ g.label }}</h3>
        <ul class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            {% for it in g.items %}
            <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 {{ not loop.first ? 'border-t border-line' : '' }}">
                <span class="w-12 shrink-0 text-sm tabular-nums text-muted">{{ it.time }}</span>
                {{ d.platform_badge(it.platform) }}
                <a class="min-w-0 flex-1 truncate font-medium hover:underline" href="#">{{ it.title }}</a>
                {{ d.status_badge(it.status) }}
            </li>
            {% endfor %}
        </ul>
    </section>
    {% endfor %}
</div>
{%- endmacro %}
