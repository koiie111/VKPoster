{#- Application shell: sidebar (from lg) or burger drawer + top bar.
    Child templates set `nav_current` (id of the active item) and may set `nav_items`, `shell_badge`.
    Blocks: title, content. -#}
{% extends 'layouts/base.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/nav.twig' as n %}
{% import 'components/overlay.twig' as o %}

{% block body %}
{#- Prototype pages (/dev/proto/*) are opened by guests and show demo data; real pages have a signed-in user and only link to what exists. -#}
{% set me = current_user() %}
{% set demo = me is null %}
{#- The back office is not inside a workspace: no switcher, no plan card. -#}
{% set ws = (demo or shell_badge is defined) ? null : current_workspace() %}
{% set acting_as = demo ? null : impersonating() %}
{% set ws_list = ws ? my_workspaces() : [] %}
{% set items = nav_items is defined ? nav_items : (demo ? [
    {id: 'dashboard', label: 'Обзор', icon: 'layout-dashboard', href: '/app'},
    {id: 'calendar', label: 'Календарь', icon: 'calendar-days', href: '/dev/proto/calendar'},
    {id: 'editor', label: 'Новый пост', icon: 'pencil', href: '/dev/proto/editor'},
    {id: 'channels', label: 'Каналы', icon: 'share-2', href: '/dev/proto/channels'},
    {id: 'media', label: 'Медиатека', icon: 'images', href: '#'},
    {id: 'analytics', label: 'Аналитика', icon: 'chart-column', href: '#'},
    {id: 'team', label: 'Команда', icon: 'users', href: '#'},
    {id: 'settings', label: 'Безопасность', icon: 'settings', href: '/account/security'}
] : workspace_nav()) %}
{% set current = nav_current is defined ? nav_current : '' %}
{% if acting_as %}
<div class="sticky top-0 z-toast flex flex-wrap items-center justify-center gap-x-4 gap-y-2 bg-warn px-4 py-2 text-sm font-semibold text-primary-fg" role="status">
    <span>Вы вошли как {{ acting_as.name }}{% if acting_as.email %} ({{ acting_as.email }}){% endif %}. Оплата и безопасность аккаунта недоступны, все действия записываются.</span>
    <form method="post" action="/impersonation/stop">{{ csrf_field() }}<button class="btn btn-secondary btn-sm" type="submit">Выйти из этого режима</button></form>
</div>
{% endif %}
<div class="lg:grid lg:min-h-screen lg:grid-cols-[16rem_1fr]">
    <aside class="hidden border-r border-line bg-surface lg:block">
        <div class="sticky top-0 flex h-screen flex-col gap-6 overflow-y-auto p-4">
            <a href="/" aria-label="{{ app_name }}: на главную">{{ d.logo() }}</a>
            {% if shell_badge is defined %}<span class="-mt-3">{{ d.badge(shell_badge, 'warn') }}</span>{% endif %}
            {{ n.sidebar_nav(items, current) }}
            {% if demo %}
            <div class="mt-auto rounded-card bg-primary-soft p-4 text-sm text-primary-softfg">
                <p class="font-semibold">Тариф «Старт»</p>
                <p class="mt-1">Использовано 12 из 30 постов в месяц</p>
                <div class="mt-3">{{ d.progress(12, 30, aria_label = 'Посты в этом месяце') }}</div>
            </div>
            {% elseif ws %}
            {% set plan = plan_card() %}
            {% if plan %}
            <div class="mt-auto rounded-card bg-primary-soft p-4 text-sm text-primary-softfg">
                <p class="font-semibold">{% if plan.href %}<a class="underline-offset-2 hover:underline" href="{{ plan.href }}">Тариф «{{ plan.name }}»</a>{% else %}Тариф «{{ plan.name }}»{% endif %}</p>
                {% if plan.trial_days is not null %}<p class="mt-1">Пробный период: осталось дней {{ plan.trial_days }}</p>{% endif %}
                {% if plan.posts_limit is not null %}
                <p class="mt-1">Постов в этом месяце: {{ plan.posts_used }} из {{ plan.posts_limit }}</p>
                <div class="mt-3">{{ d.progress(min(plan.posts_used, plan.posts_limit), max(plan.posts_limit, 1), aria_label = 'Посты в этом месяце') }}</div>
                {% else %}
                <p class="mt-1">Постов в этом месяце: {{ plan.posts_used }}, без ограничений</p>
                {% endif %}
            </div>
            {% endif %}
            {% endif %}
        </div>
    </aside>

    {% set drawer_body %}{% if ws %}<p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-muted">Рабочее пространство</p><ul class="mb-4">{% for w in ws_list %}<li><a class="nav-link" href="{{ w.href }}"{% if w.current %} aria-current="true"{% endif %}>{{ icon(w.current ? 'check' : 'house', 'h-5 w-5') }}<span class="truncate">{{ w.name }}</span></a></li>{% endfor %}<li><a class="nav-link" href="{{ url('workspace.new') }}">{{ icon('plus', 'h-5 w-5') }}Создать пространство</a></li></ul>{% elseif demo %}<p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-muted">Рабочее пространство</p><ul class="mb-4"><li><a class="nav-link" href="#">{{ icon('check', 'h-5 w-5') }}Кофейня «Зерно»</a></li><li><a class="nav-link" href="#">{{ icon('house', 'h-5 w-5') }}Школа йоги</a></li></ul>{% endif %}{{ n.sidebar_nav(items, current, 'Навигация') }}{% endset %}{{ o.drawer('nav-drawer', app_name, side = 'left', body = drawer_body) }}
    <div class="min-w-0">
        <header class="sticky top-0 z-sticky flex items-center gap-2 border-b border-line bg-surface/95 px-3 py-2 backdrop-blur sm:px-6">
            <button type="button" class="btn btn-ghost !px-0 w-11 lg:hidden" data-dialog-open="nav-drawer" aria-label="Открыть меню">{{ icon('menu', 'h-5 w-5') }}</button>
            <span class="lg:hidden">{{ d.logo('!text-base', true) }}</span>
            {% if demo %}<div class="hidden sm:block">{{ n.workspace_switcher('Кофейня «Зерно»', [
                {name: 'Кофейня «Зерно»', href: '#'}, {name: 'Школа йоги', href: '#'}
            ]) }}</div>{% elseif ws %}<div class="hidden sm:block">{{ n.workspace_switcher(ws.workspaceName, ws_list, url('workspace.new')) }}</div>{% endif %}
            <div class="ml-auto flex items-center gap-1 sm:gap-2">
                {% if demo %}
                <a class="btn btn-primary btn-sm max-sm:!px-0 max-sm:w-11" href="/dev/proto/editor" aria-label="Создать пост">{{ icon('plus', 'h-4 w-4') }}<span class="max-sm:sr-only">Создать пост</span></a>
                <button type="button" class="btn btn-ghost !px-0 w-11 max-sm:hidden" aria-label="Уведомления">{{ icon('bell', 'h-5 w-5') }}</button>
                {% endif %}
                <span class="max-sm:hidden">{{ n.theme_toggle() }}</span>
                {{ n.user_menu(me ? me.name : 'Анна Смирнова', me ? (me.email ?? '') : 'anna@example.com') }}
            </div>
        </header>
        <main id="main" class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
            {% if not demo %}{% for notice in platform_notices() %}<div class="mb-4">{{ d.alert('warning', 'Соцсеть отвечает с перебоями', notice) }}</div>{% endfor %}{% endif %}
            {% set plan_notice = plan_limit_notice() %}
            {% if plan_notice %}<div class="mb-6">{% set plan_notice_action %}<a class="btn btn-primary btn-sm" href="{{ plan_notice.href }}">Перейти на тариф</a>{% endset %}{{ d.alert('warning', 'Это ограничение тарифа', plan_notice.text, plan_notice_action) }}</div>{% endif %}
            {% block content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
