{#- Admin: staff roles. Variables: members, roles. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/admin.twig' as a %}
{% set nav_current = 'staff' %}
{% block title %}Сотрудники · Админка{% endblock %}
{% block content %}
{{ d.page_header('Сотрудники', 'Кому ещё открыта админка и что они там могут. Вы, как владелец, можете всё. Каждому сотруднику нужна двухфакторная защита.') }}
<div class="grid gap-4 lg:grid-cols-[2fr_1fr]">
    <section class="card !p-0 overflow-hidden" aria-labelledby="staff-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="staff-h">Сотрудники с ролями</h2>
    {% set rows %}
        {% for m in members %}
        <tr>
            <td><a class="font-medium hover:underline" href="/admin/users/{{ m.user_id }}">{{ m.name }}</a><span class="block text-xs text-muted">{{ m.email ?? 'без почты' }}</span></td>
            <td>{{ d.badge(m.role.label, 'primary') }}<span class="block text-xs text-muted">{{ m.role.hint }}</span></td>
            <td>
                <form class="flex flex-col gap-2" method="post" action="/admin/staff/{{ m.user_id }}/remove">{{ csrf_field() }}
                    <label class="sr-only" for="rm-{{ m.user_id }}">Код подтверждения для {{ m.name }}</label>
                    <input class="field" id="rm-{{ m.user_id }}" name="confirm_code" inputmode="numeric" autocomplete="one-time-code" placeholder="Код из аутентификатора" required>
                    <button class="btn btn-danger btn-sm" type="submit">Снять роль</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    {% endset %}
    {{ d.table([{label: 'Человек'}, {label: 'Роль'}, {label: 'Действие'}], empty = members is empty, empty_title = 'Пока только вы', empty_text = 'Назначьте роль справа, если нужен помощник.', caption = 'Сотрудники', body = rows) }}
    </section>
    <section class="card" aria-labelledby="add-h"><h2 class="text-lg font-semibold" id="add-h">Назначить роль</h2>
        <form class="mt-3 flex flex-col gap-4" method="post" action="/admin/staff">{{ csrf_field() }}
            {{ f.input('email', 'Почта аккаунта', type = 'email', required = true, hint = 'Аккаунт должен уже существовать и иметь подтверждённую почту.') }}
            {% set options = {} %}{% for r in roles %}{% set options = options|merge({(r.value): r.label ~ ': ' ~ r.hint}) %}{% endfor %}
            {{ f.select('role', 'Роль', options, required = true) }}
            {{ a.step_up('assign-code') }}
            {{ f.button('Назначить', type = 'submit') }}
        </form>
    </section>
</div>
{% endblock %}
