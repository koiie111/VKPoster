{#- Admin: one campaign. Variables: campaign, name, subject, body, segment, plans, platforms, reach, stats, preview, per_minute. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/admin.twig' as a %}
{% set nav_current = 'campaigns' %}
{% set editable = campaign is null or campaign.status == 'draft' %}
{% block title %}{{ campaign ? campaign.name : 'Новая рассылка' }} · Админка{% endblock %}
{% block content %}
{{ d.page_header(campaign ? campaign.name : 'Новая рассылка', 'Письмо уйдёт только согласившимся на новости и не отписавшимся. В каждом письме есть ссылка «Отписаться».') }}
<div class="grid gap-4 lg:grid-cols-2">
    <form class="card flex flex-col gap-4" method="post" action="/admin/campaigns{{ campaign ? '/' ~ campaign.public_id : '' }}">
        {{ csrf_field() }}
        <fieldset class="flex flex-col gap-4" {{ editable ? '' : 'disabled' }}>
            {{ f.input('name', 'Название (для вас)', value = name, required = true) }}
            {{ f.input('subject', 'Тема письма', value = subject, required = true) }}
            {{ f.textarea('body', 'Текст письма', value = body, rows = 12, max = 5000, required = true, hint = 'Markdown: **жирный**, [ссылка](https://…), списки. {name} подставит имя.', id = 'campaign-body') }}
            <fieldset><legend class="label">Кому: тарифы</legend><div class="flex flex-wrap gap-x-5 gap-y-1">{% for code, pname in plans %}{{ f.checkbox('plans[]', pname, checked = code in segment.plans, value = code, id = 'cp-' ~ code) }}{% endfor %}</div><p class="hint">Ничего не отмечено — любой тариф.</p></fieldset>
            <fieldset><legend class="label">Кому: есть канал в сети</legend><div class="flex flex-wrap gap-x-5 gap-y-1">{% for code, pname in platforms %}{{ f.checkbox('platforms[]', pname, checked = code in segment.platforms, value = code, id = 'cf-' ~ code) }}{% endfor %}</div></fieldset>
            {{ f.select('activity', 'Активность за 30 дней', {any: 'Любая', active: 'Заходили', inactive: 'Не заходили'}, value = segment.activity) }}
        </fieldset>
        {% if editable %}<div>{{ f.button('Сохранить', type = 'submit', icon = 'save') }}</div>{% else %}<p class="text-sm text-muted">Запущенную рассылку менять нельзя.</p>{% endif %}
    </form>
    <div class="flex flex-col gap-4">
        <section class="card" aria-labelledby="reach-h"><h2 class="text-lg font-semibold" id="reach-h">Кому уйдёт</h2>
            <p class="mt-2 text-3xl font-bold tabular-nums">{{ reach }}</p>
            <p class="text-sm text-muted">человек сейчас подходят под условия (согласились на новости, подтвердили почту). Скорость отправки: {{ per_minute }} писем в минуту.</p>
        </section>
        {% if campaign %}
        <section class="card" aria-labelledby="go-h"><h2 class="text-lg font-semibold" id="go-h">Отправка</h2>
            {% if stats and campaign.status != 'draft' %}
            <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm"><dt class="text-muted">Всего</dt><dd>{{ stats.total }}</dd><dt class="text-muted">Отправлено</dt><dd>{{ stats.sent }}</dd><dt class="text-muted">Ждут</dt><dd>{{ stats.queued }}</dd><dt class="text-muted">Ошибки</dt><dd>{{ stats.failed }}</dd><dt class="text-muted">Пропущены (отписались)</dt><dd>{{ stats.skipped }}</dd><dt class="text-muted">Отписались после письма</dt><dd>{{ stats.unsubscribed }}</dd></dl>
            {% endif %}
            <div class="mt-3 flex flex-col gap-3">
                <form method="post" action="/admin/campaigns/{{ campaign.public_id }}/test">{{ csrf_field() }}{{ f.button('Отправить тест мне', type = 'submit', variant = 'secondary', icon = 'send') }}</form>
                {% if campaign.status == 'draft' %}
                <form class="flex flex-col gap-3 border-t border-line pt-3" method="post" action="/admin/campaigns/{{ campaign.public_id }}/start">{{ csrf_field() }}
                    <p class="text-sm text-muted">Сохраните изменения перед запуском. Состав получателей зафиксируется в момент запуска.</p>
                    {{ a.step_up('start-code') }}
                    {{ f.button('Запустить рассылку', type = 'submit', icon = 'rocket') }}
                </form>
                {% elseif campaign.status == 'sending' %}
                <form method="post" action="/admin/campaigns/{{ campaign.public_id }}/cancel">{{ csrf_field() }}{{ f.button('Остановить', type = 'submit', variant = 'danger') }}</form>
                {% endif %}
            </div>
        </section>
        {% endif %}
        <section class="card" aria-labelledby="pv-h"><h2 class="text-lg font-semibold" id="pv-h">Как выглядит письмо</h2>
            <p class="mt-1 text-sm text-muted">Показано для сохранённого текста.</p>
            <div class="mt-3 rounded-ctl border border-line bg-sunken p-3 text-sm [&_a]:underline">{{ preview|raw }}</div>
        </section>
    </div>
</div>
{% endblock %}
