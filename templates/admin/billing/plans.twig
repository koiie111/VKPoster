{#- Admin: price list. Variables: plans. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% set nav_current = 'plans' %}
{% block title %}Тарифы и цены · Админка{% endblock %}
{% block content %}
{{ d.page_header('Тарифы и цены', 'Изменения действуют для новых платежей. Уже оплаченный период и сохранённая цена продления не меняются.') }}
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for plan in plans %}
    <section class="card flex flex-col" aria-label="{{ plan.name }}">
        <h2 class="flex flex-wrap items-center gap-2 text-lg font-semibold">{{ plan.name }}{% if not plan.isPublic %} {{ d.badge('Скрыт', 'neutral') }}{% endif %}</h2>
        <p class="mt-2 text-sm text-muted">{{ plan.code }}</p>
        <p class="mt-2 text-2xl font-bold">{{ plan.prices.month.RUB is defined ? money(plan.prices.month.RUB) : '0 ₽' }}<span class="text-sm font-normal text-muted"> в месяц</span></p>
        <p class="text-sm text-muted">{{ plan.prices.year.RUB is defined ? money(plan.prices.year.RUB) ~ ' в год' : 'годовой цены нет' }}</p>
        <p class="mt-3 text-sm text-muted">Каналов: {{ plan.limits.channels is null ? 'без ограничений' : plan.limits.channels }}</p>
        <div class="mt-auto pt-4"><a class="btn btn-secondary btn-sm" href="/admin/plans/{{ plan.code }}">Изменить</a></div>
    </section>
    {% endfor %}
</div>
{% endblock %}
