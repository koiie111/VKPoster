{#- Admin: one provider notification. Variables: event. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'webhooks' %}
{% set tz = current_user().timezone %}
{% block title %}Уведомление · Админка{% endblock %}
{% block content %}
{% set actions %}{% if event.payment_public_id and admin_can('finance.manage') %}<form method="post" action="/admin/webhooks/{{ event.id }}/replay">{{ csrf_field() }}{{ f.button('Обработать заново', type = 'submit', variant = 'secondary', icon = 'refresh-cw') }}</form>{% endif %}{% endset %}
{{ d.page_header('Уведомление ' ~ event.provider, event.type ~ ' · ' ~ event.received_at|date('d.m.Y H:i:s', tz), body = actions) }}
<section class="card" aria-labelledby="e-h"><h2 class="text-lg font-semibold" id="e-h">Что произошло</h2>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
        <dt class="text-muted">Итог</dt><dd>{{ {received: 'Получено', processed: 'Обработано', ignored: 'Пропущено', rejected: 'Отклонено'}[event.outcome] ?? event.outcome }}{% if event.detail %} · {{ event.detail }}{% endif %}</dd>
        <dt class="text-muted">Номер события</dt><dd class="break-all">{{ event.event_id }}</dd>
        <dt class="text-muted">Платёж</dt><dd>{% if event.payment_public_id %}<a class="underline underline-offset-2" href="/admin/payments/{{ event.payment_public_id }}">открыть платёж</a>{% else %}{{ event.payment_ref ?? 'не указан' }}{% endif %}</dd>
    </dl>
    <p class="mt-4 text-sm text-muted">«Обработать заново» спрашивает у провайдера, что с платежом на самом деле, и применяет это. Подписанный оригинал мы не храним.</p>
</section>
<section class="card mt-4" aria-labelledby="b-h"><h2 class="text-lg font-semibold" id="b-h">Копия уведомления</h2>
    <p class="mt-1 text-sm text-muted">Данные карты, контакты, токены и подписи скрыты.</p>
    {% if event.payload %}<pre class="mt-3 max-h-[32rem] overflow-auto rounded-ctl bg-sunken p-4 text-xs"><code>{{ event.payload }}</code></pre>{% else %}<p class="mt-3 text-muted">Копии нет: уведомление пришло до того, как мы начали её сохранять.</p>{% endif %}
</section>
{% endblock %}
