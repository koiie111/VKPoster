{#- Admin: channel health by network. Variables: platforms [{platform, counts}], broken. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% set nav_current = 'channels' %}
{% set tz = current_user().timezone %}
{% block title %}Каналы · Админка{% endblock %}
{% block content %}
{{ d.page_header('Каналы по соцсетям', 'Сколько каналов в каком состоянии. Сбои сразу у многих каналов одной сети значат проблему на стороне сети.') }}
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for row in platforms %}
    <section class="card" aria-label="{{ row.platform.label }}"><h2 class="text-lg font-semibold">{{ row.platform.label }}</h2>
        <ul class="mt-3 flex flex-col gap-1 text-sm">{% for status, label in {active: 'Подключены', paused: 'На паузе', error: 'Нужно проверить', revoked: 'Нужно переподключить'} %}<li class="flex justify-between"><span class="text-muted">{{ label }}</span><span class="font-semibold tabular-nums {{ (status in ['error', 'revoked']) and (row.counts[status] ?? 0) > 0 ? 'text-bad-fg' : '' }}">{{ row.counts[status] ?? 0 }}</span></li>{% endfor %}</ul>
    </section>
    {% else %}<p class="text-muted">Ни одна сеть не включена (PLATFORMS_ENABLED).</p>{% endfor %}
</div>
<section class="card mt-6 !p-0 overflow-hidden" aria-labelledby="broken-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="broken-h">Каналы, которым нужно внимание</h2>
{% set rows %}
    {% for c in broken %}<tr>
        <td><span class="block font-medium">{{ c.title }}</span><span class="block text-xs text-muted">{{ c.platform }}</span></td>
        <td><a class="hover:underline" href="/admin/workspaces/{{ c.workspace_public_id }}">{{ c.workspace_name }}</a></td>
        <td class="text-sm text-muted">{{ c.last_error ?? '—' }}</td>
        <td class="whitespace-nowrap text-muted">{{ c.last_health_at ? c.last_health_at|date('d.m.Y H:i', tz) : '—' }}</td>
    </tr>{% endfor %}
{% endset %}
{{ d.table([{label: 'Канал'}, {label: 'Пространство'}, {label: 'Причина'}, {label: 'Проверен'}], empty = broken is empty, empty_title = 'Всё в порядке', empty_text = 'Нет каналов, которым нужно переподключение.', caption = 'Каналы с проблемами', body = rows) }}
</section>
{% endblock %}
