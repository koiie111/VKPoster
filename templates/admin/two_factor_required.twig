{#- Shown to a superadmin who has not switched on two-factor protection yet. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% import 'components/display.twig' as d %}
{% block title %}Нужна двухфакторная защита · {{ app_name }}{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Сначала включите двухфакторную защиту</h1>
<p class="mt-2 text-muted">Админка показывает данные всех пользователей, поэтому пускает только тех, у кого вход защищён кодом из приложения. Это занимает минуту.</p>
<div class="mt-6 flex flex-col gap-3">{{ f.button('Включить защиту', href = '/account/security', block = true) }}{{ f.button('Вернуться в приложение', variant = 'secondary', href = '/app', block = true) }}</div>
{% endblock %}
