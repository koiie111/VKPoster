{#- Admin: one user. Variables: person, workspaces, activity. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/overlay.twig' as o %}
{% import 'components/admin.twig' as a %}
{% set nav_current = 'users' %}
{% set tz = current_user().timezone %}
{% block title %}{{ person.name }} · Админка{% endblock %}
{% block content %}
{% set actions %}
    {% if not person.is_superadmin and person.id != current_user().id %}
        {% if person.status != 'blocked' %}
        {% if admin_can('users.impersonate') %}{{ f.button('Войти как этот человек', variant = 'secondary', icon = 'eye', attrs = {'data-dialog-open': 'impersonate-user'}) }}{% endif %}
        {% if admin_can('users.manage') %}{{ f.button('Заблокировать', variant = 'danger', attrs = {'data-dialog-open': 'block-user'}) }}{% endif %}
        {% elseif admin_can('users.manage') %}
        <form method="post" action="/admin/users/{{ person.id }}/unblock">{{ csrf_field() }}{{ f.button('Разблокировать', type = 'submit') }}</form>
        {% endif %}
    {% endif %}
{% endset %}
{{ d.page_header(person.name, person.email ?? 'Без почты (вход через соцсеть)', body = actions) }}
<div class="grid gap-4 lg:grid-cols-2">
    <section class="card" aria-labelledby="about-h"><h2 class="text-lg font-semibold" id="about-h">Аккаунт</h2>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
            <dt class="text-muted">Номер</dt><dd>{{ person.id }}</dd>
            <dt class="text-muted">Статус</dt><dd>{{ person.status == 'blocked' ? 'Заблокирован' : 'Активен' }}{% if person.is_superadmin %}, сотрудник{% endif %}</dd>
            <dt class="text-muted">Почта подтверждена</dt><dd>{{ person.email_verified_at ? person.email_verified_at|date('d.m.Y H:i', tz) : 'нет' }}</dd>
            <dt class="text-muted">Двухфакторная защита</dt><dd>{{ person.totp_enabled_at ? 'включена' : 'выключена' }}</dd>
            <dt class="text-muted">Согласие с документами</dt><dd>{{ person.consent_version ?? 'нет' }}{% if person.consent_at %} ({{ person.consent_at|date('d.m.Y', tz) }}){% endif %}</dd>
            <dt class="text-muted">Зарегистрирован</dt><dd>{{ person.created_at|date('d.m.Y H:i', tz) }}</dd>
        </dl>
    </section>
    <section class="card" aria-labelledby="ws-h"><h2 class="text-lg font-semibold" id="ws-h">Пространства</h2>
        {% if workspaces %}<ul class="mt-3 divide-y divide-line">{% for w in workspaces %}<li class="py-2"><a class="font-medium hover:underline" href="/admin/workspaces/{{ w.public_id }}">{{ w.name }}</a><p class="text-sm text-muted">{{ w.owner_id == person.id ? 'владелец' : w.role }} · {{ w.plan ?? 'без тарифа' }}</p></li>{% endfor %}</ul>
        {% else %}<p class="mt-3 text-muted">Не состоит ни в одном пространстве.</p>{% endif %}
    </section>
</div>
<section class="card mt-4" aria-labelledby="act-h"><h2 class="text-lg font-semibold" id="act-h">Последние действия</h2>
    {% if activity %}<ul class="mt-3 divide-y divide-line text-sm">{% for a in activity %}<li class="flex flex-wrap justify-between gap-2 py-2"><span>{{ a.action }}{% if a.subject_type %} <span class="text-muted">· {{ a.subject_type }} {{ a.subject_id }}</span>{% endif %}</span><span class="text-muted">{{ a.created_at|date('d.m.Y H:i', tz) }}{% if a.ip %} · {{ a.ip }}{% endif %}</span></li>{% endfor %}</ul>
    {% else %}<p class="mt-3 text-muted">Записей нет.</p>{% endif %}
</section>
{% set block_fields %}{{ f.textarea('reason', 'Причина', rows = 3, max = 500, required = true, hint = 'Человек увидит её, когда попробует войти.', id = 'block-reason') }}{% endset %}
{{ a.danger_dialog('block-user', 'Заблокировать аккаунт?', person.name, 'Человек будет разлогинен на всех устройствах и не сможет войти, пока вы его не разблокируете.', '/admin/users/' ~ person.id ~ '/block', 'Заблокировать', fields = block_fields) }}
{{ a.danger_dialog('impersonate-user', 'Войти под этим человеком?', person.name, 'Вы увидите сервис его глазами на час. Оплата и безопасность аккаунта будут закрыты, все действия попадут в журнал.', '/admin/users/' ~ person.id ~ '/impersonate', 'Войти', danger = false) }}
{% endblock %}
