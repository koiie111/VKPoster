{#- Admin: users. Variables: q, result, base. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'users' %}
{% set tz = current_user().timezone %}
{% block title %}Пользователи · Админка{% endblock %}
{% block content %}
{{ d.page_header('Пользователи', 'Всего найдено: ' ~ result.total ~ '.') }}
<form class="mb-4 flex flex-wrap items-end gap-3" method="get" action="/admin/users" role="search">
    <div class="min-w-[16rem] flex-1">{{ f.input('q', 'Найти пользователя', value = q, placeholder = 'Почта, имя или номер') }}</div>
    {{ f.button('Найти', type = 'submit', variant = 'secondary', icon = 'search') }}
</form>
<div class="card !p-0 overflow-hidden">
{% set rows %}
    {% for u in result.rows %}
    <tr>
        <td><a class="flex items-center gap-3 hover:underline" href="/admin/users/{{ u.id }}">{{ d.avatar(u.name, size = 'sm') }}<span><span class="block font-medium">{{ u.name }}</span><span class="block text-xs text-muted">{{ u.email ?? 'без почты' }}</span></span></a></td>
        <td>{{ u.workspaces }}</td>
        <td>{% if u.is_superadmin %}{{ d.badge('Сотрудник', 'primary') }} {% endif %}{% if u.status == 'blocked' %}{{ d.badge('Заблокирован', 'bad') }}{% elseif u.totp_enabled_at %}{{ d.badge('2FA', 'ok') }}{% endif %}</td>
        <td class="whitespace-nowrap text-muted">{{ u.created_at|date('d.m.Y H:i', tz) }}</td>
    </tr>
    {% endfor %}
{% endset %}
{{ d.table([{label: 'Пользователь'}, {label: 'Пространств'}, {label: 'Статус'}, {label: 'Зарегистрирован'}], empty = result.rows is empty, empty_title = 'Никого не нашли', empty_text = 'Попробуйте другой запрос.', caption = 'Пользователи', body = rows) }}
</div>
<div class="mt-4">{{ d.pagination(result.page, result.pages, base) }}</div>
{% endblock %}
