{#- Admin: edit a document. Variables: is_new, kind, slug, doc, kinds, history, live, preview. -#}
{% extends 'layouts/admin.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'content' %}
{% set tz = current_user().timezone %}
{% block title %}{{ is_new ? 'Новый документ' : doc.title }} · Админка{% endblock %}
{% block content %}
{{ d.page_header(is_new ? 'Новая статья или документ' : doc.title, is_new ? 'Статья справки или юридический документ.' : (kinds[kind] ~ ' · ' ~ slug)) }}
{% if doc.draft %}<div class="mb-4">{{ d.alert('info', 'Это черновик', 'На сайте пока показан опубликованный текст. Опубликуйте черновик, когда будете готовы.') }}</div>{% endif %}
<div class="grid gap-4 lg:grid-cols-2">
    <form class="card flex flex-col gap-4" method="post" action="/admin/content">{{ csrf_field() }}
        {% if is_new %}
            {{ f.select('kind', 'Что это', kinds, value = kind, required = true) }}
            {{ f.input('slug', 'Адрес (латиницей)', value = '', required = true, hint = 'Например connect-vk или terms', id = 'doc-slug') }}
        {% else %}<input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="slug" value="{{ slug }}">{% endif %}
        {{ f.input('title', 'Название', value = doc.title, required = true, id = 'doc-title') }}
        {% if kind == 'legal' or is_new %}
            {{ f.input('version', 'Версия (дата)', value = doc.version ?? '', hint = 'Для юридического документа: 2026-10-05. Новая дата у обязательного документа заставит людей согласиться заново.', id = 'doc-version') }}
            {{ f.checkbox('required', 'Люди должны принять документ при регистрации', checked = doc.required, id = 'doc-required') }}
        {% endif %}
        {{ f.textarea('body', 'Текст (Markdown)', value = doc.body, rows = 22, required = true, hint = 'Заголовки #, списки -, **жирный**, [ссылка](https://…). HTML в тексте не работает: его покажет как текст.', id = 'doc-body') }}
        <div class="flex flex-wrap gap-2">
            <button class="btn btn-secondary" type="submit" name="action" value="draft">Сохранить черновик</button>
            <button class="btn btn-primary" type="submit" name="action" value="publish">Опубликовать</button>
            <button class="btn btn-ghost" type="submit" formaction="/admin/content/preview" formtarget="_blank" name="action" value="preview">Предпросмотр</button>
        </div>
    </form>
    <div class="flex flex-col gap-4">
        <section class="card" aria-labelledby="pv-h"><h2 class="text-lg font-semibold" id="pv-h">Как это выглядит</h2><div class="mt-3 max-h-[28rem] overflow-auto text-sm [&_a]:underline [&_h1]:text-xl [&_h2]:text-lg [&_ul]:list-disc [&_ul]:pl-5">{{ preview|raw }}</div></section>
        {% if not is_new %}
        <section class="card !p-0 overflow-hidden" aria-labelledby="h-h"><h2 class="px-5 pt-5 text-lg font-semibold" id="h-h">История</h2>
        {% set rows %}{% for r in history %}<tr>
            <td class="whitespace-nowrap text-muted">{{ r.created_at|date('d.m.Y H:i', tz) }}<span class="block text-xs">{{ r.author ?? '' }}</span></td>
            <td>{{ d.badge(r.status == 'published' ? 'Опубликован' : 'Черновик', r.status == 'published' ? 'ok' : 'warn') }}{{ r.version ? ' ' ~ r.version : '' }}</td>
            <td><form method="post" action="/admin/content/revisions/{{ r.id }}/restore">{{ csrf_field() }}<input type="hidden" name="back" value="/admin/content/{{ kind }}/{{ slug }}"><button class="btn btn-ghost btn-sm" type="submit">В черновик</button></form></td>
        </tr>{% endfor %}{% endset %}
        {{ d.table([{label: 'Когда'}, {label: 'Что'}, {label: ''}], empty = history is empty, empty_title = 'Изменений в админке не было', empty_text = 'Сейчас показан текст из файла.', caption = 'История', body = rows) }}
        {% if doc.draft %}<form class="p-5 pt-0" method="post" action="/admin/content/{{ kind }}/{{ slug }}/discard">{{ csrf_field() }}{{ f.button('Удалить черновик', type = 'submit', variant = 'ghost', size = 'sm') }}</form>{% endif %}
        </section>
        {% endif %}
    </div>
</div>
{% endblock %}
