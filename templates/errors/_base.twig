{% extends 'layouts/auth.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}

{% block title %}{{ title }} · {{ app_name }}{% endblock %}

{% block content %}
    <div class="text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-warn-soft text-warn-fg">{{ icon('triangle-alert', 'h-7 w-7') }}</span>
        <h1 class="mt-4 text-2xl font-bold">{{ title }}</h1>
        <p class="mt-2 text-muted">{% block message %}{% endblock %}</p>
        <div class="mt-6">{{ f.button(t('Вернуться на главную'), href = '/') }}</div>
        {% if error_id %}
            <p class="mt-4 text-xs text-muted">{{ t('Код ошибки для поддержки: :id', {id: error_id}) }}</p>
        {% endif %}
    </div>
    {% if debug %}
        <pre class="mt-4 overflow-x-auto rounded-ctl bg-sunken p-3 text-xs">{{ debug }}</pre>
    {% endif %}
{% endblock %}

{% block auth_footer %}{% endblock %}
