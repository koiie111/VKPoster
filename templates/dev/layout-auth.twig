{#- Layout sample: sign-in page. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% block title %}Вход · {{ app_name }}{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">С возвращением!</h1>
<p class="mt-1 text-muted">Войдите, чтобы продолжить планировать посты.</p>
<form class="mt-6 flex flex-col gap-4" method="get" action="/dev/proto/dashboard">
    {{ f.input('email', 'Почта', type = 'email', required = true, autocomplete = 'email', placeholder = 'anna@example.com') }}
    {{ f.input('password', 'Пароль', type = 'password', required = true, autocomplete = 'current-password', hint = 'Не меньше 10 символов.') }}
    {{ f.button('Войти', type = 'submit', block = true) }}
</form>
<p class="mt-4 text-center text-sm"><a class="font-medium text-primary-text underline underline-offset-2" href="#">Забыли пароль?</a></p>
<div class="my-5 flex items-center gap-3 text-sm text-muted"><span class="h-px flex-1 bg-line"></span>или<span class="h-px flex-1 bg-line"></span></div>
<div class="flex flex-col gap-2">{{ f.button('Войти через ВКонтакте', variant = 'secondary', block = true) }}{{ f.button('Войти через Telegram', variant = 'secondary', block = true) }}</div>
{% endblock %}
{% block auth_footer %}Нет аккаунта? <a class="font-medium text-primary-text underline underline-offset-2" href="#">Зарегистрируйтесь</a>{% endblock %}
