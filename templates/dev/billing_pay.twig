{#- Payment page of the test provider (local development only). Variables: payment, return. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% import 'components/display.twig' as d %}
{% block title %}Тестовая оплата · {{ app_name }}{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Тестовая оплата</h1>
<p class="mt-1 text-muted">Это замена настоящей платёжной системе для разработки. Сумма: <strong>{{ money(payment.amount, payment.currency) }}</strong>.</p>
<form class="mt-6 flex flex-col gap-3" method="post" action="/dev/billing/pay/{{ payment.publicId }}">
    {{ csrf_field() }}
    <input type="hidden" name="return" value="{{ return }}">
    <button class="btn btn-primary btn-block" type="submit" name="answer" value="pay">Оплатить</button>
    <button class="btn btn-secondary btn-block" type="submit" name="answer" value="pay_declining">Оплатить картой с отказами</button>
    <button class="btn btn-ghost btn-block" type="submit" name="answer" value="decline">Отклонить платёж</button>
    <p class="text-sm text-muted">Карта «с отказами» оплатит сейчас, но при продлении банк откажет: так проверяются повторы.</p>
</form>
{% endblock %}
{% block auth_footer %}Работает только вне production.{% endblock %}
