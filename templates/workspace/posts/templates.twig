{#- Post templates. Variables: templates (id, name, created, can_delete), base. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/overlay.twig' as o %}

{% set nav_current = 'editor' %}
{% block title %}Шаблоны постов · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Календарь', href: base ~ '/calendar'}, {label: 'Шаблоны'}]) }}
<div class="mt-3">{{ d.page_header('Шаблоны постов', 'Заготовки, из которых за пару секунд получается новый пост.', body = f.button('Новый пост', href = base ~ '/posts/new', icon = 'plus')) }}</div>
{% if templates is empty %}
<div class="card">{{ d.empty_state('Шаблонов пока нет', 'Когда напишете пост, который будете повторять, нажмите в редакторе «Сохранить как шаблон». Он появится здесь.', 'copy', 'Создать пост', base ~ '/posts/new') }}</div>
{% else %}
<ul class="grid gap-3">
    {% for t in templates %}
    <li class="card flex flex-wrap items-center gap-x-4 gap-y-3">
        <div class="min-w-0 flex-1 basis-48"><p class="break-words font-semibold">{{ t.name }}</p><p class="text-sm text-muted">Сохранён {{ t.created }}</p></div>
        {{ f.button('Создать пост', href = base ~ '/posts/new?template=' ~ t.id, size = 'sm', icon = 'plus') }}
        {% if t.can_delete %}
            {{ f.button('Удалить', variant = 'ghost', size = 'sm', icon = 'trash-2', attrs = {'data-dialog-open': 'del-' ~ t.id}) }}
            {{ o.confirm_dialog('del-' ~ t.id, 'Удалить шаблон?', t.name, 'Уже созданные из него посты не изменятся.', base ~ '/templates/' ~ t.id ~ '/delete') }}
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endif %}
{% endblock %}
