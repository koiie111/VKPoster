{% import 'components/display.twig' as d %}
{% set total=report.totals %}
<div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    {% for label,key in {'Публикации':'publications','Охват':'reach','Вовлечённость':'engagement','ER, %':'er'} %}
        <div class="card p-4">
            <p class="text-sm text-muted">
                {{ label }}
            </p>
            <p class="mt-2 text-2xl font-semibold">
                {{ attribute(total,key) is null ? 'Нет данных' : attribute(total,key) }}
            </p>
        </div>
    {% endfor %}
</div>
<p class="my-3 text-sm text-muted">
    Нет данных ≠ 0. Сводный счётчик показан только при полном покрытии: охват
    {{ total.coverage.reach }}
    /
    {{ total.publications }}
    , вовлечённость
    {{ total.coverage.engagement }}
    /
    {{ total.publications }}
    . ER = взаимодействия / охват × 100.
</p>
{% if report.posts is empty %}
    {{ d.empty_state('Пока нет публикаций за этот период','После публикации первые снимки появятся через час. Выберите другой период, если посты уже выходили.','chart-column') }}
{% endif %}
<section class="card my-4 p-4">
    <h2 class="font-semibold">
        По дням
    </h2>
    <div class="relative h-64">
        <canvas data-analytics-chart data-series="{{ report.daily|json_encode|e('html_attr') }}" role="img" aria-label="Охват и вовлечённость по дням. Значения доступны в таблице ниже.">
        </canvas>
    </div>
    {% set day_rows %}
        {% for day,row in report.daily %}
            <tr>
                <th scope="row">
                    {{ day }}
                </th>
                <td>
                    {{ row.publications }}
                </td>
                <td>
                    {{ row.reach is null?'Нет данных':row.reach }}
                </td>
                <td>
                    {{ row.engagement is null?'Нет данных':row.engagement }}
                </td>
            </tr>
        {% endfor %}
    {% endset %}
    {{ d.table([{label:'Дата'},{label:'Публикации'},{label:'Охват'},{label:'Вовлечённость'}],caption='Данные графика по дням',body=day_rows) }}
</section>
{% for heading,rows in {'Сравнение каналов':report.by_channel,'По платформам':report.platforms} %}
    <section class="card my-4 p-4">
        <h2 class="font-semibold">
            {{ heading }}
        </h2>
        {% set comparison_rows %}
            {% for name,row in rows %}
                <tr>
                    <th scope="row">
                        {{ row.label|default(name) }}
                    </th>
                    <td>
                        {{ row.publications }}
                    </td>
                    <td>
                        {{ row.reach is null?'Нет данных':row.reach }}
                    </td>
                    <td>
                        {{ row.er is null?'Нет данных':row.er }}
                    </td>
                </tr>
            {% endfor %}
        {% endset %}
        {{ d.table([{label:'Канал / платформа'},{label:'Публикации'},{label:'Охват'},{label:'ER, %'}],caption=heading,body=comparison_rows) }}
    </section>
{% endfor %}
<section class="card my-4 p-4">
    <h2 class="font-semibold">
        Топ постов по вовлечённости
    </h2>
    {% for p in report.top %}
        <article class="border-b border-line py-3">
            <p class="break-words">
                {{ p.text }}
            </p>
            <p class="text-sm text-muted">
                {{ p.title }}
                ·
                {{ p.local_date }}
                ·
                {{ p.metrics.engagement }}
                взаимодействий · ER
                {{ p.er is null?'нет данных':p.er~' %' }}
            </p>
        </article>
    {% else %}
        <p class="text-sm text-muted">
            Нет постов с доступной вовлечённостью.
        </p>
    {% endfor %}
</section>
<section class="card my-4 p-4">
    <h2 class="font-semibold">
        Лучшее время
    </h2>
    <p class="my-2 text-sm text-muted">
        Нужно минимум 20 постов с известной вовлечённостью и 5 в одной ячейке. Это наблюдение о ваших публикациях, а не гарантия результата.
    </p>
    {% include 'workspace/analytics/best.twig' %}
    {% set heat_columns=[{label:'День'}] %}
    {% for h in 0..23 %}
        {% set heat_columns=heat_columns|merge([{label:h}]) %}
    {% endfor %}
    {% set heat_rows %}
        {% for day,label in {1:'Пн',2:'Вт',3:'Ср',4:'Чт',5:'Пт',6:'Сб',7:'Вс'} %}
            <tr>
                <th scope="row">
                    {{ label }}
                </th>
                {% for cell in report.best.cells %}
                    {% if cell.day==day %}
                        <td class="{{ cell.average is not null?'bg-primary-soft':'text-muted' }}" title="{{ cell.count }} постов">
                            {{ cell.average is null?'—':cell.average }}
                        </td>
                    {% endif %}
                {% endfor %}
            </tr>
        {% endfor %}
    {% endset %}
    {{ d.table(heat_columns,caption='Средняя вовлечённость: день недели и час',body=heat_rows) }}
</section>
{% if report.followers %}
    <section class="card p-4">
        <h2 class="font-semibold">
            Подписчики: ежедневные снимки
        </h2>
        {% for row in report.followers %}
            <p class="text-sm">
                {{ row.title }}
                ·
                {{ row.observed_at|slice(0,10) }}
                UTC ·
                {{ row.followers is null?'Нет данных':row.followers }}
            </p>
        {% endfor %}
    </section>
{% endif %}
