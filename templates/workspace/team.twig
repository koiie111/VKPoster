{#- Team: members, open invitations, invite form, ownership transfer. Variables: workspace (context), user, members, invitations, invite_roles, role_labels, role_descriptions, policy. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/forms.twig' as f %}
{% import 'components/display.twig' as d %}
{% import 'components/overlay.twig' as o %}
{% set nav_current = 'team' %}
{% set base = '/w/' ~ workspace.workspacePublicId %}
{% block title %}Команда · {{ app_name }}{% endblock %}
{% block content %}
{{ d.page_header('Команда', 'Кто работает в пространстве «' ~ workspace.workspaceName ~ '» и что им разрешено.') }}

<div class="flex flex-col gap-6">
    <section class="card" id="invite" aria-labelledby="invite-title">
        <h2 class="text-lg font-semibold" id="invite-title">Пригласить в команду</h2>
        <p class="mt-1 text-sm text-muted">Мы отправим письмо со ссылкой. Она действует 7 дней и подходит только для этого адреса.</p>
        <form class="mt-4 grid gap-4 sm:grid-cols-[1fr_14rem_auto] sm:items-start" method="post" action="{{ base }}/team/invitations">
            {{ csrf_field() }}
            {{ f.input('email', 'Почта', type = 'email', value = old('email'), required = true, autocomplete = 'off', placeholder = 'kolleg@example.com', error = errors('email')|first) }}
            {{ f.select('role', 'Роль', invite_roles, value = old('role', 'editor'), required = true, error = errors('role')|first) }}
            <div class="sm:pt-7">{{ f.button('Пригласить', type = 'submit') }}</div>
        </form>
        <dl class="mt-4 grid gap-x-6 gap-y-1 text-sm text-muted sm:grid-cols-2">
            {% for value, label in invite_roles %}<div><dt class="inline font-medium text-fg">{{ label }}.</dt> <dd class="inline">{{ role_descriptions[value] }}</dd></div>{% endfor %}
        </dl>
    </section>

    <section class="card !p-0" aria-labelledby="members-title">
        <h2 class="p-5 pb-3 text-lg font-semibold" id="members-title">Участники ({{ members|length }})</h2>
        <ul class="divide-y divide-line border-t border-line">
            {% for m in members %}
            {% set manageable = m.userId != user.id and policy.canRemove(workspace.role, m.role) %}
            <li class="flex flex-col gap-3 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
                <div class="flex min-w-0 items-center gap-3">
                    {{ d.avatar(m.name, size = 'sm') }}
                    <div class="min-w-0">
                        <p class="break-words font-medium">{{ m.name }}{% if m.userId == user.id %} <span class="text-muted">(вы)</span>{% endif %}</p>
                        <p class="break-all text-sm text-muted">{{ m.email ?? 'Без почты' }}</p>
                        <p class="text-sm text-muted">В команде с&nbsp;{{ m.joinedAt|date('d.m.Y', workspace.timezone) }}</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    {% if manageable %}
                    <form class="flex flex-wrap items-center gap-2" method="post" action="{{ base }}/team/members/{{ m.publicId }}/role">
                        {{ csrf_field() }}
                        <label class="sr-only" for="role-{{ m.publicId }}">Роль участника {{ m.name }}</label>
                        <select class="field !w-auto" id="role-{{ m.publicId }}" name="role">
                            {% for value, label in invite_roles %}<option value="{{ value }}"{% if value == m.role.value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                        </select>
                        {{ f.button('Сменить', variant = 'secondary', type = 'submit', attrs = {'aria-label': 'Сменить роль: ' ~ m.name}) }}
                    </form>
                    {{ f.button('Исключить', variant = 'ghost', attrs = {'data-dialog-open': 'remove-' ~ m.publicId, 'aria-label': 'Исключить: ' ~ m.name}) }}
                    {% else %}
                    {{ d.badge(role_labels[m.role.value], m.role.value == 'owner' ? 'info' : 'neutral') }}
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
    </section>

    <section class="card !p-0" aria-labelledby="invitations-title">
        <h2 class="p-5 pb-3 text-lg font-semibold" id="invitations-title">Ждут ответа ({{ invitations|length }})</h2>
        {% if invitations %}
        <ul class="divide-y divide-line border-t border-line">
            {% for i in invitations %}
            <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                    <p class="break-all font-medium">{{ i.email }}</p>
                    <p class="text-sm text-muted">{{ role_labels[i.role.value] }} · ссылка действует до {{ i.expiresAt|date('d.m.Y H:i', workspace.timezone) }}</p>
                </div>
                {% if policy.canRevokeInvitation(workspace.role, i.role) %}
                <form method="post" action="{{ base }}/team/invitations/{{ i.publicId }}/revoke">{{ csrf_field() }}{{ f.button('Отозвать', variant = 'ghost', type = 'submit', attrs = {'aria-label': 'Отозвать приглашение: ' ~ i.email}) }}</form>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="p-5 pt-0">{{ d.empty_state('Открытых приглашений нет', 'Пригласите коллегу или клиента по почте: он появится здесь, пока не примет приглашение.', 'mail') }}</div>
        {% endif %}
    </section>

    {% if can('workspace.transfer') %}
    <section class="card" id="transfer" aria-labelledby="transfer-title">
        <h2 class="text-lg font-semibold" id="transfer-title">Передать владение</h2>
        <p class="mt-1 text-sm text-muted">Новый владелец получит доступ к оплате и удалению пространства. Вы станете администратором.</p>
        {% set candidates = {} %}
        {% for m in members %}{% if m.userId != user.id and m.role.value != 'client' %}{% set candidates = candidates|merge({(m.publicId): m.name ~ (m.email ? ' · ' ~ m.email : '')}) %}{% endif %}{% endfor %}
        {% if candidates %}
        <form class="mt-4 grid max-w-2xl gap-4 sm:grid-cols-2" method="post" action="{{ base }}/team/transfer">
            {{ csrf_field() }}
            {{ f.select('member', 'Новый владелец', candidates, required = true) }}
            {{ f.input('confirm_name', 'Название пространства', required = true, autocomplete = 'off', hint = 'Чтобы подтвердить, введите точно: ' ~ workspace.workspaceName) }}
            <div class="sm:col-span-2">{{ f.button('Передать владение', variant = 'danger', type = 'submit') }}</div>
        </form>
        {% else %}
        <p class="mt-3 text-sm text-muted">Сначала пригласите в команду человека, которому хотите передать пространство (не клиента).</p>
        {% endif %}
    </section>
    {% endif %}
</div>

{% for m in members %}{% if m.userId != user.id and policy.canRemove(workspace.role, m.role) %}
{{ o.confirm_dialog('remove-' ~ m.publicId, 'Исключить участника?', m.name, 'Он потеряет доступ к пространству «' ~ workspace.workspaceName ~ '». Вернуться можно только по новому приглашению.', base ~ '/team/members/' ~ m.publicId ~ '/remove', 'Исключить ' ~ m.name) }}
{% endif %}{% endfor %}
{% endblock %}
