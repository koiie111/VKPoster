{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'channels' %}
{% block title %}Подключить YouTube · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Каналы', href: base}, {label: 'Подключить YouTube'}]) }}
<div class="mt-3">{{ d.page_header('Подключить канал YouTube', 'Разрешите загрузку коротких видео по расписанию.') }}</div>
{% if not available %}
    {{ d.alert('warning', 'Подключение YouTube пока не настроено', 'Администратор должен настроить проект Google Cloud. Попробуйте позже.') }}
{% else %}
    <div class="card max-w-2xl space-y-4">
        <p>Откроется Google. Выберите аккаунт, привязанный к нужному каналу YouTube, и разрешите загрузку и просмотр видео. Пароль Google мы не получаем.</p>
        <p class="text-sm text-muted">Если вы управляете несколькими каналами, выберите нужный канал на странице Google. Для подключения другого канала повторите вход.</p>
        {{ f.button('Войти через Google для YouTube', href = base ~ '/connect/youtube/start', icon = 'play') }}
    </div>
{% endif %}
{% endblock %}
