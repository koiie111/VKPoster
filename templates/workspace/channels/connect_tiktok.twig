{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'channels' %}
{% block title %}Подключить TikTok · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Каналы', href: base}, {label: 'Подключить TikTok'}]) }}
<div class="mt-3">{{ d.page_header('Подключить TikTok', 'Разрешите публикацию видео в вашем аккаунте через TikTok Login.') }}</div>
{% if not available %}
    {{ d.alert('warning', 'Подключение TikTok пока не настроено', 'Администратор должен настроить приложение TikTok. Попробуйте позже.') }}
{% else %}
    <div class="card max-w-2xl space-y-4">
        <p>Для подключения откроется TikTok. Разрешите доступ к профилю и публикации видео. Пароль от TikTok мы не получаем.</p>
        <p class="text-sm text-muted">Перед публикацией нужно выбрать видимость, указать рекламный контент и подтвердить право использовать музыку. Возможность открытой публикации зависит от доступа приложения TikTok.</p>
        {{ f.button('Войти через TikTok', href = base ~ '/connect/tiktok/start', icon = 'video') }}
    </div>
{% endif %}
{% endblock %}
