{#- Connecting Instagram. Variables: workspace (context), base, available (the Meta application is configured), redirect_uri. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'channels' %}
{% block title %}Подключить Instagram · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Каналы', href: base}, {label: 'Подключить Instagram'}]) }}
<div class="mt-3">{{ d.page_header('Подключить аккаунт Instagram', 'Мы будем публиковать в ваш профессиональный аккаунт: фото, карусели, Reels и истории.') }}</div>
{% if not available %}
    {{ d.alert('warning', 'Подключение Instagram пока не настроено', 'Мы уже знаем об этом и скоро всё включим. Попробуйте позже.') }}
{% else %}
<ol class="grid gap-5 sm:max-w-2xl">
    <li class="flex gap-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft font-semibold text-primary-softfg" aria-hidden="true">1</span>
        <div class="min-w-0 flex-1">
            <p class="font-semibold">Проверьте тип аккаунта</p>
            <p class="mt-1 text-sm text-muted">Публиковать можно только в профессиональный аккаунт (бизнес или автор). Переключить личный аккаунт можно в приложении Instagram: «Настройки» → «Аккаунт» → «Переключиться на профессиональный».</p>
        </div>
    </li>
    <li class="flex gap-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft font-semibold text-primary-softfg" aria-hidden="true">2</span>
        <div class="min-w-0 flex-1">
            <p class="font-semibold">Войдите через Instagram</p>
            <p class="mt-1 text-sm text-muted">Откроется страница Instagram. Разрешите публикацию и комментарии: без этих прав посты не уйдут. Пароль от Instagram мы не видим.</p>
            <div class="mt-3">{{ f.button('Войти через Instagram', href = base ~ '/connect/instagram/start', icon = 'image') }}</div>
        </div>
    </li>
</ol>
<p class="mt-6 text-sm text-muted sm:max-w-2xl">Доступ продлевается автоматически. Если вы отзовёте его в настройках Instagram или смените пароль, мы напишем вам, а посты в этот аккаунт не уйдут. Instagram не позволяет удалять и закреплять посты со стороны сервиса: это делается в самом приложении.</p>
{% endif %}
{% endblock %}
