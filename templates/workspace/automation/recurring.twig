{#- Recurring posts. Variables: rules, posts, preselected, days, today, can_manage, has_feature, timezone, base. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/overlay.twig' as o %}

{% set nav_current = 'automation' %}
{% block title %}Повторяющиеся посты · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Автоматизация', href: base ~ '/automation'}, {label: 'Повторяющиеся посты'}]) }}
<div class="mt-3">{{ d.page_header('Повторяющиеся посты', 'Выберите черновик и расписание: за сутки до каждого выхода мы делаем копию и ставим её в календарь. Сам черновик не публикуется.') }}</div>
{% if not has_feature %}<div class="mb-5">{{ d.alert('info', 'Повторы есть на тарифах «Старт» и выше', 'Посмотрите тарифы: на них повторы, очереди и правила «если → то».') }}</div>{% endif %}

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
    <section aria-labelledby="rules-title">
        <h2 class="sr-only" id="rules-title">Ваши повторы</h2>
        {% if rules is empty %}
            <div class="card">{{ d.empty_state('Повторов пока нет', 'Подойдёт для рубрик и напоминаний: «каждый понедельник в 10:00» или «31-го числа».', 'repeat') }}</div>
        {% else %}
        <ul class="grid gap-4">
            {% for r in rules %}
            <li class="card flex flex-wrap items-center gap-x-4 gap-y-3">
                <div class="min-w-0 flex-1 basis-56">
                    <p class="flex flex-wrap items-center gap-2 font-semibold"><span class="break-words">{% if r.post_id %}<a class="hover:underline" href="{{ base }}/posts/{{ r.post_id }}">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}</span>{{ d.badge(r.finished ? 'Закончился' : (r.enabled ? 'Работает' : 'Остановлен'), r.enabled ? 'ok' : 'neutral') }}</p>
                    <p class="text-sm text-muted">{{ r.summary }}</p>
                    <p class="text-sm text-muted">{% if r.next %}Следующая копия: {{ r.next }}. {% endif %}Сделано копий: {{ r.done }}{% if r.left is not null %}, осталось {{ r.left }}{% endif %}.</p>
                    {% if r.error %}<p class="mt-1 flex gap-1.5 text-sm text-bad-fg">{{ icon('circle-alert', 'mt-0.5 h-4 w-4') }}<span>{{ r.error }}</span></p>{% endif %}
                </div>
                {% if can_manage %}
                <div class="flex flex-wrap items-center gap-2">
                    {% if not r.finished %}<form method="post" action="{{ base }}/recurring/{{ r.id }}/{{ r.enabled ? 'pause' : 'resume' }}">{{ csrf_field() }}{{ f.button(r.enabled ? 'Остановить' : 'Запустить', variant = 'secondary', size = 'sm', type = 'submit', icon = r.enabled ? 'pause' : 'play') }}</form>{% endif %}
                    {{ f.button('Удалить', variant = 'ghost', size = 'sm', icon = 'trash-2', attrs = {'data-dialog-open': 'del-rec-' ~ r.id}) }}
                    {{ o.confirm_dialog('del-rec-' ~ r.id, 'Удалить повтор?', r.title, 'Копии, которые уже созданы и стоят в календаре, останутся.', base ~ '/recurring/' ~ r.id ~ '/delete') }}
                </div>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>

    {% if can_manage %}
    <section class="card h-fit" aria-labelledby="new-title">
        <h2 class="mb-4 text-lg font-semibold" id="new-title">Новый повтор</h2>
        {% if errors('form') %}<div class="mb-4">{{ d.alert('error', 'Повтор не создан', errors('form')|first) }}</div>{% endif %}
        {% if posts is empty %}
            {{ d.empty_state('Нет черновиков', 'Сначала напишите пост и сохраните его как черновик, потом вернитесь сюда.', 'pencil', 'Написать пост', base ~ '/posts/new') }}
        {% else %}
        <form method="post" action="{{ base }}/recurring" class="flex flex-col gap-4" novalidate>
            {{ csrf_field() }}
            {{ f.select('post', 'Какой пост повторять', posts|reduce((c, p) => c|merge({(p.id): p.title}), {}), value = old('post', preselected), required = true) }}
            {{ f.select('frequency', 'Как часто', {daily: 'Каждый день', weekdays: 'По дням недели', every_n: 'Каждые N дней', monthly: 'Раз в месяц'}, value = old('frequency', 'weekdays'), required = true) }}
            <fieldset class="flex flex-col gap-2">
                <legend class="label">Дни недели <span class="font-normal text-muted">(для «По дням недели»)</span></legend>
                {% set chosen = old('weekdays', []) %}
                <div class="flex flex-wrap gap-x-4 gap-y-2">{% for number, name in days %}{{ f.checkbox('weekdays[]', name, checked = (number ~ '') in chosen, value = number, id = 'rec-day-' ~ number) }}{% endfor %}</div>
            </fieldset>
            <div class="grid grid-cols-2 gap-3">
                {{ f.input('interval', 'Раз в сколько дней', type = 'number', value = old('interval', '2'), hint = 'Для «Каждые N дней»', attrs = {min: 1, max: 365}) }}
                {{ f.input('month_day', 'Число месяца', type = 'number', value = old('month_day', '1'), hint = 'Для «Раз в месяц». 31 = последний день в коротких месяцах', attrs = {min: 1, max: 31}) }}
            </div>
            {{ f.input('time', 'Во сколько', type = 'time', value = old('time', '10:00'), required = true, hint = 'Часовой пояс пространства: ' ~ timezone ~ '.') }}
            <div class="grid grid-cols-2 gap-3">
                {{ f.input('starts_on', 'Начать с', type = 'date', value = old('starts_on', today), required = true) }}
                {{ f.input('ends_on', 'Закончить', type = 'date', value = old('ends_on', ''), hint = 'Можно не указывать') }}
            </div>
            {{ f.input('max_count', 'Не больше раз', type = 'number', value = old('max_count', ''), hint = 'Можно не указывать', attrs = {min: 1, max: 1000}) }}
            {{ f.button('Создать повтор', type = 'submit', icon = 'repeat') }}
        </form>
        {% endif %}
    </section>
    {% endif %}
</div>
{% endblock %}
