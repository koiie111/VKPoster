{#- An RSS feed. Variables: feed, values (after "check the feed"), selected, queue_id, channels, queues, intervals, default_template, preview, preview_error, base. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}

{% set nav_current = 'automation' %}
{% set v = values ?? {} %}
{% block title %}{{ feed ? 'Лента RSS' : 'Новая лента RSS' }} · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Автоматизация', href: base ~ '/automation'}, {label: 'Ленты RSS', href: base ~ '/rss'}, {label: feed ? feed.name : 'Новая лента'}]) }}
<div class="mt-3">{{ d.page_header(feed ? 'Лента RSS' : 'Новая лента RSS', 'Вставьте адрес ленты и нажмите «Проверить ленту»: мы покажем, какими получатся посты.') }}</div>
<form method="post" action="{{ base }}/rss/{{ feed ? feed.publicId : '' }}" class="card flex max-w-3xl flex-col gap-6" novalidate>
    {{ csrf_field() }}
    {% if errors('form') %}{{ d.alert('error', 'Лента не сохранена', errors('form')|first) }}{% endif %}
    {{ f.input('name', 'Название', value = v.name ?? old('name', feed ? feed.name : ''), required = true, placeholder = 'Например, «Блог компании»', attrs = {maxlength: 100}) }}
    {{ f.input('url', 'Адрес ленты', type = 'url', value = v.url ?? old('url', feed ? feed.url : ''), required = true, placeholder = 'https://example.com/feed.xml', hint = 'Адрес RSS или Atom, который начинается с http:// или https://.', attrs = {maxlength: 2000}) }}
    {{ f.textarea('template', 'Как выглядит пост', value = v.template ?? old('template', feed ? feed.template : default_template), rows = 5, max = 2000, hint = 'Подставим {title} (заголовок), {summary} (краткое описание) и {link} (ссылка на запись).') }}

    <div class="flex flex-wrap items-center gap-3">
        {{ f.button('Проверить ленту', variant = 'secondary', type = 'submit', icon = 'refresh-cw', attrs = {formaction: base ~ '/rss/preview'}) }}
        <span class="text-sm text-muted">Ничего не сохраняется и не публикуется.</span>
    </div>
    {% if preview_error %}{{ d.alert('error', 'Лента не прочиталась', preview_error) }}{% endif %}
    {% if preview %}
    <section aria-labelledby="preview-title" class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold" id="preview-title">Так будут выглядеть последние записи</h2>
        {% for item in preview %}
        <article class="rounded-card border border-line p-4">
            <p class="whitespace-pre-line break-words text-[0.9375rem]">{{ item.text }}</p>
            {% if item.image %}<p class="mt-2 flex items-center gap-1.5 text-sm text-muted">{{ icon('image', 'h-4 w-4') }}К посту прикрепим картинку из записи.</p>{% endif %}
        </article>
        {% endfor %}
    </section>
    {% endif %}

    <fieldset class="flex flex-col gap-3">
        <legend class="label">Куда публиковать<span class="text-bad-fg" aria-hidden="true"> *</span></legend>
        {% for ch in channels %}{{ f.checkbox('channels[]', ch.name, checked = ch.id in selected, value = ch.id, hint = ch.platform_label, id = 'rss-ch-' ~ ch.id) }}{% endfor %}
        {% if channels is empty %}<p class="text-sm text-muted">Сначала подключите канал в разделе «Каналы».</p>{% endif %}
    </fieldset>

    <fieldset class="flex flex-col gap-3">
        <legend class="label">Что делать с новыми записями</legend>
        {% set current_mode = v.mode ?? old('mode', feed ? feed.mode : 'draft') %}
        {{ f.radio('mode', 'Сохранять в черновики', 'draft', checked = current_mode == 'draft', hint = 'Вы проверите пост и запланируете сами.', id = 'rss-mode-draft') }}
        {{ f.radio('mode', 'Ставить в очередь', 'queue', checked = current_mode == 'queue', hint = 'Пост сам встанет в ближайший свободный слот.', id = 'rss-mode-queue') }}
        {% if queues %}{{ f.select('queue', 'Очередь', queues|reduce((c, q) => c|merge({(q.id): q.name}), {}), value = v.queue ?? old('queue', queue_id), hint = 'Нужна для режима «Ставить в очередь». Каналы ленты должны входить в очередь.') }}
        {% else %}<p class="text-sm text-muted">Очередей пока нет. Режим «Ставить в очередь» заработает, когда вы <a class="font-medium text-primary-text underline underline-offset-2" href="{{ base }}/queues/new">создадите очередь</a>.</p>{% endif %}
        {{ f.select('interval', 'Как часто читать ленту', intervals, value = v.interval ?? old('interval', feed ? feed.intervalMinutes : 60)) }}
    </fieldset>

    <div class="flex flex-wrap items-center gap-3 border-t border-line pt-5">
        {{ f.button(feed ? 'Сохранить ленту' : 'Подключить ленту', type = 'submit', icon = 'save') }}
        {{ f.button('Отмена', variant = 'ghost', href = base ~ '/rss') }}
    </div>
</form>
{% endblock %}
