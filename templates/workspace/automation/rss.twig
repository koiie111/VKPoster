{#- RSS feeds. Variables: feeds, can_manage, has_feature, base. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% import 'components/overlay.twig' as o %}

{% set nav_current = 'automation' %}
{% block title %}Ленты RSS · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Автоматизация', href: base ~ '/automation'}, {label: 'Ленты RSS'}]) }}
{% set head %}{% if can_manage %}{{ f.button('Добавить ленту', href = base ~ '/rss/new', icon = 'plus') }}{% endif %}{% endset %}
<div class="mt-3">{{ d.page_header('Ленты RSS', 'Новые записи сайта или блога превращаются в черновики или встают в очередь. Старые записи мы не трогаем.', body = head) }}</div>
{% if not has_feature %}<div class="mb-5">{{ d.alert('info', 'Ленты есть на тарифах «Старт» и выше', 'Посмотрите тарифы: на «Старте» одна лента, на старших без ограничений.') }}</div>{% endif %}
{% if feeds is empty %}
<div class="card">{{ d.empty_state('Лент пока нет', 'Вставьте адрес ленты (RSS или Atom), и каждая новая запись станет постом.', 'globe', can_manage ? 'Добавить ленту' : null, can_manage ? base ~ '/rss/new' : null) }}</div>
{% else %}
<ul class="grid gap-4">
    {% for feed in feeds %}
    <li class="card flex flex-wrap items-start gap-x-4 gap-y-3">
        <div class="min-w-0 flex-1 basis-64">
            <p class="flex flex-wrap items-center gap-2 font-semibold"><span class="break-words">{{ feed.name }}</span>{{ d.badge(feed.enabled ? 'Читается' : 'Остановлена', feed.enabled ? 'ok' : 'neutral') }}</p>
            <p class="break-all text-sm text-muted">{{ feed.url }}</p>
            <p class="text-sm text-muted">{{ feed.interval }} · записи {{ feed.mode }} · учтено записей: {{ feed.entries }}{% if feed.last_checked %} · проверена {{ feed.last_checked }}{% endif %}</p>
            {% if feed.error %}<p class="mt-1 flex gap-1.5 text-sm text-bad-fg">{{ icon('circle-alert', 'mt-0.5 h-4 w-4') }}<span>{{ feed.error }}</span></p>{% endif %}
        </div>
        {% if can_manage %}
        <div class="flex flex-wrap items-center gap-2">
            <form method="post" action="{{ base }}/rss/{{ feed.id }}/{{ feed.enabled ? 'disable' : 'enable' }}">{{ csrf_field() }}{{ f.button(feed.enabled ? 'Остановить' : 'Включить', variant = 'secondary', size = 'sm', type = 'submit', icon = feed.enabled ? 'pause' : 'play') }}</form>
            {{ f.button('Изменить', variant = 'secondary', size = 'sm', href = base ~ '/rss/' ~ feed.id ~ '/edit', icon = 'pencil') }}
            {{ f.button('Удалить', variant = 'ghost', size = 'sm', icon = 'trash-2', attrs = {'data-dialog-open': 'del-rss-' ~ feed.id}) }}
            {{ o.confirm_dialog('del-rss-' ~ feed.id, 'Удалить ленту?', feed.name, 'Посты, которые уже созданы из этой ленты, останутся.', base ~ '/rss/' ~ feed.id ~ '/delete') }}
        </div>
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endif %}
{% endblock %}
