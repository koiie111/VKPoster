{#- Bulk import. Variables: recent, can_schedule, base. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}

{% set nav_current = 'automation' %}
{% block title %}Загрузка постов из файла · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Автоматизация', href: base ~ '/automation'}, {label: 'Загрузка из файла'}]) }}
<div class="mt-3">{{ d.page_header('Загрузка постов из файла', 'Заполните таблицу и загрузите её: мы проверим каждую строку и покажем, что не так, ещё до создания постов.', body = f.button('Скачать шаблон', variant = 'secondary', href = base ~ '/import/template.csv', icon = 'download')) }}</div>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
    <section class="card" aria-labelledby="upload-title">
        <h2 class="mb-4 text-lg font-semibold" id="upload-title">Загрузить таблицу</h2>
        <form method="post" action="{{ base }}/import" enctype="multipart/form-data" class="flex flex-col gap-5" novalidate>
            {{ csrf_field() }}
            {{ f.dropzone('file', 'Файл', hint = 'CSV или Excel (XLSX), до 2 МБ и 500 строк', accept = '.csv,.xlsx,text/csv', multiple = false) }}
            <fieldset class="flex flex-col gap-3">
                <legend class="label">Что сделать с постами</legend>
                {{ f.radio('mode', 'Сохранить в черновики', 'draft', checked = true, hint = 'Дата и время не нужны. Посты можно будет проверить и запланировать.', id = 'import-mode-draft') }}
                {% if can_schedule %}{{ f.radio('mode', 'Запланировать по датам из таблицы', 'schedule', hint = 'В каждой строке нужны дата и время.', id = 'import-mode-schedule') }}{% endif %}
            </fieldset>
            {{ f.button('Проверить файл', type = 'submit', icon = 'upload') }}
        </form>
    </section>
    <section class="card h-fit" aria-labelledby="columns-title">
        <h2 class="mb-3 text-lg font-semibold" id="columns-title">Какие нужны столбцы</h2>
        <dl class="flex flex-col gap-2 text-sm">
            <div><dt class="font-medium">Дата и Время</dt><dd class="text-muted">14.10.2026 и 10:30. Время по поясу пространства.</dd></div>
            <div><dt class="font-medium">Каналы</dt><dd class="text-muted">Названия ваших каналов через «;».</dd></div>
            <div><dt class="font-medium">Текст</dt><dd class="text-muted">Текст поста. Можно с разметкой: **жирный**, _курсив_.</dd></div>
            <div><dt class="font-medium">Медиа</dt><dd class="text-muted">Прямые ссылки на картинки или видео через пробел.</dd></div>
        </dl>
    </section>
</div>
<section class="mt-8" aria-labelledby="recent-title">
    <h2 class="mb-3 text-lg font-semibold" id="recent-title">Последние загрузки</h2>
    {% if recent is empty %}<div class="card">{{ d.empty_state('Загрузок пока не было', 'Скачайте шаблон, заполните его и загрузите здесь.', 'file') }}</div>
    {% else %}
    <ul class="grid gap-3">
        {% for b in recent %}
        <li class="card flex flex-wrap items-center gap-x-4 gap-y-2">
            <div class="min-w-0 flex-1 basis-56"><p class="break-words font-medium"><a class="hover:underline" href="{{ base }}/import/{{ b.id }}">{{ b.filename }}</a></p><p class="text-sm text-muted">Строк: {{ b.rows }}, без ошибок: {{ b.ok }} · {{ b.mode }}{% if b.status == 'done' %} · создано постов: {{ b.created }}{% endif %}</p></div>
            {{ d.badge(b.status == 'done' ? 'Готово' : (b.status == 'preview' ? 'Ждёт подтверждения' : 'Загружается'), b.status == 'done' ? 'ok' : (b.status == 'preview' ? 'warn' : 'info')) }}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
{% endblock %}
