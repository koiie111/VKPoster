{#- Plan comparison and checkout. Variables: workspace (context), cards, rows, columns, period, year_saving, gateways, is_trial, trial_ends. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/display.twig' as d %}
{% import 'components/forms.twig' as f %}
{% set nav_current = 'billing' %}
{% set base = '/w/' ~ workspace.workspacePublicId ~ '/billing' %}
{% block title %}Тарифы · {{ app_name }}{% endblock %}
{% block content %}
{{ d.page_header('Тарифы', 'Выберите тариф для пространства «' ~ workspace.workspaceName ~ '». Сменить или отменить его можно в любой момент.') }}

<div class="flex flex-col gap-6">
    {% if is_trial %}{{ d.alert('info', 'Сейчас у вас пробный период', 'Он закончится ' ~ trial_ends ~ '. Если выбрать тариф сейчас, оплаченный срок начнётся сегодня, остаток пробного периода не переносится.') }}{% endif %}

    <nav aria-label="Срок оплаты" class="flex flex-wrap items-center gap-2">
        <a class="btn btn-sm {{ period == 'month' ? 'btn-primary' : 'btn-secondary' }}" href="{{ base }}/plans?period=month"{% if period == 'month' %} aria-current="true"{% endif %}>Платить помесячно</a>
        <a class="btn btn-sm {{ period == 'year' ? 'btn-primary' : 'btn-secondary' }}" href="{{ base }}/plans?period=year"{% if period == 'year' %} aria-current="true"{% endif %}>Платить за год{% if year_saving %} (выгода до {{ year_saving }}%){% endif %}</a>
    </nav>

    {% if not gateways %}{{ d.alert('warning', 'Оплата пока не подключена', 'Приём платежей ещё настраивается. Загляните позже или напишите нам.') }}{% endif %}

    <form method="post" action="{{ base }}/checkout" class="flex flex-col gap-6">
        {{ csrf_field() }}
        <input type="hidden" name="period" value="{{ period }}">
        <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {% for c in cards %}
            <li class="card flex flex-col{{ c.is_current ? ' ring-2 ring-primary' : '' }}">
                <h2 class="flex flex-wrap items-center gap-2 text-lg font-semibold">{{ c.name }}{% if c.is_current %} {{ d.badge('Ваш тариф', 'primary') }}{% endif %}</h2>
                <p class="mt-3"><span class="text-3xl font-bold">{{ c.price ?? '—' }}</span> <span class="text-muted">{{ c.per }}</span></p>
                <p class="min-h-5 text-sm text-muted">{{ c.monthly ?? '' }}</p>
                <ul class="mt-4 flex-1 space-y-2 text-sm">
                    {% for line in c.highlights %}<li class="flex gap-2">{{ icon('check', 'mt-0.5 h-4 w-4 shrink-0 text-ok') }}<span>{{ line }}</span></li>{% endfor %}
                </ul>
                <div class="mt-5 flex flex-col gap-2">
                    {% if c.action.note %}<p class="text-sm text-muted">{{ c.action.note }}</p>{% endif %}
                    <button type="submit" name="plan" value="{{ c.code }}" class="btn btn-block !whitespace-normal {{ c.action.primary ? 'btn-primary' : 'btn-secondary' }}"{% if c.action.disabled or not gateways %} disabled{% endif %}>{{ c.action.label }}</button>
                </div>
            </li>
            {% endfor %}
        </ul>

        {% if gateways %}
        <fieldset class="card">
            <legend class="sr-only">Как оплатить</legend>
            <h2 class="text-lg font-semibold" aria-hidden="true">Как оплатить</h2>
            <div class="mt-3 flex flex-col gap-3">
                {% for name, label in gateways %}{{ f.radio('gateway', label, name, loop.first) }}{% endfor %}
                {{ f.checkbox('keep_card', 'Продлевать автоматически', true, '1', 'Мы сохраним способ оплаты у платёжной системы и спишем деньги в конце срока. Отключить можно в любой момент. Номер карты мы не видим и не храним.') }}
            </div>
        </fieldset>
        {% endif %}
    </form>

    <section class="card !p-0" aria-labelledby="compare-title">
        <h2 class="p-5 pb-3 text-lg font-semibold" id="compare-title">Что входит в каждый тариф</h2>
        {% set body %}
            {% for r in rows %}
            <tr>
                <th scope="row" class="font-medium">{{ r.label }}</th>
                {% for col in columns %}<td{% if col.current %} class="bg-primary-soft/40"{% endif %}>{{ r.cells[col.code] }}</td>{% endfor %}
            </tr>
            {% endfor %}
        {% endset %}
        {% set cols = [{label: 'Возможность'}] %}
        {% for col in columns %}{% set cols = cols|merge([{label: col.name ~ (col.current ? ' (ваш)' : '')}]) %}{% endfor %}
        {{ d.table(cols, caption = 'Сравнение тарифов', body = body) }}
    </section>
</div>
{% endblock %}
