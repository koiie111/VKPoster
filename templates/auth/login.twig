{#- Sign-in form. Errors for the whole form arrive as errors('form'). -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% import 'components/display.twig' as d %}
{% import 'components/social.twig' as soc %}
{% block title %}Вход · {{ app_name }}{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">С возвращением!</h1>
<p class="mt-1 text-muted">Войдите, чтобы продолжить планировать посты.</p>
{% if errors('form') %}<div class="mt-5">{{ d.alert('error', 'Не удалось войти', errors('form')|first) }}</div>{% endif %}
<form class="mt-6 flex flex-col gap-4" method="post" action="/login">
    {{ csrf_field() }}
    {{ f.input('email', 'Почта', type = 'email', value = old('email'), required = true, autocomplete = 'email', placeholder = 'anna@example.com', error = errors('email')|first, attrs = old('email') ? {} : {autofocus: ''}) }}
    {{ f.input('password', 'Пароль', type = 'password', required = true, autocomplete = 'current-password', attrs = old('email') ? {autofocus: ''} : {}) }}
    {{ f.checkbox('remember', 'Запомнить меня на этом устройстве', checked = old('remember') == '1') }}
    {{ f.button('Войти', type = 'submit', block = true) }}
</form>
<p class="mt-4 text-center text-sm"><a class="font-medium text-primary-text underline underline-offset-2" href="{{ url('auth.forgot') }}">Забыли пароль?</a></p>
{% if social.buttons|length %}
{{ soc.divider('или войдите через') }}
{{ soc.sign_in_buttons(social) }}
{% endif %}
{% endblock %}
{% block auth_footer %}Нет аккаунта? <a class="font-medium text-primary-text underline underline-offset-2" href="{{ url('register') }}">Зарегистрируйтесь</a>{% endblock %}
