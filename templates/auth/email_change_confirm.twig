{#- Landing page of the "confirm new address" link. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% block title %}Подтверждение нового адреса · {{ app_name }}{% endblock %}
{% block content %}
<div class="text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft text-primary-text">{{ icon('mail', 'h-7 w-7') }}</span>
    <h1 class="mt-4 text-2xl font-bold">Сменить адрес почты?</h1>
    <p class="mt-2 text-muted">Для входа в аккаунт будет использоваться адрес <strong class="break-all text-fg">{{ new_email }}</strong>.</p>
    <form class="mt-6" method="post" action="{{ url('account.email.confirm.show', {token: token}) }}">
        {{ csrf_field() }}
        {{ f.button('Подтвердить новый адрес', type = 'submit', block = true) }}
    </form>
</div>
{% endblock %}
{% block auth_footer %}{% endblock %}
