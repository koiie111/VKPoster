{#- Landing page of the confirmation link: the POST behind the button does the work. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% block title %}Подтверждение почты · {{ app_name }}{% endblock %}
{% block content %}
<div class="text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft text-primary-text">{{ icon('mail', 'h-7 w-7') }}</span>
    <h1 class="mt-4 text-2xl font-bold">Подтвердите почту</h1>
    <p class="mt-2 text-muted">Нажмите кнопку, и мы подтвердим адрес. Это займёт секунду.</p>
    <form class="mt-6" method="post" action="{{ url('auth.verify.show', {token: token}) }}">
        {{ csrf_field() }}
        {{ f.button('Подтвердить почту', type = 'submit', block = true) }}
    </form>
</div>
{% endblock %}
{% block auth_footer %}{% endblock %}
