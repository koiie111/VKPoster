{#- Shown after sign-up. Same page for new and existing addresses. -#}
{% extends 'layouts/auth.twig' %}
{% import 'components/forms.twig' as f %}
{% block title %}Проверьте почту · {{ app_name }}{% endblock %}
{% block content %}
<div class="text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft text-primary-text">{{ icon('mail', 'h-7 w-7') }}</span>
    <h1 class="mt-4 text-2xl font-bold">Проверьте почту</h1>
    <p class="mt-2 text-muted">Мы отправили письмо на <strong class="break-all text-fg">{{ email }}</strong>. Откройте его и нажмите кнопку, чтобы подтвердить адрес.</p>
    <p class="mt-4 text-sm text-muted">Письма нет? Загляните в «Спам». Если и там пусто, попробуйте зарегистрироваться ещё раз с правильным адресом.</p>
    <div class="mt-6">{{ f.button('Перейти ко входу', variant = 'secondary', href = url('login')) }}</div>
</div>
{% endblock %}
{% block auth_footer %}{% endblock %}
