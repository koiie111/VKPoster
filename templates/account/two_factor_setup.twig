{#- Enable two-factor: scan the QR code, confirm with the first code. Variables: user, secret_groups. -#}
{% extends 'layouts/app.twig' %}
{% import 'components/forms.twig' as f %}
{% import 'components/display.twig' as d %}
{% set nav_current = 'settings' %}
{% block title %}Двухфакторная защита · {{ app_name }}{% endblock %}
{% block content %}
{{ d.breadcrumbs([{label: 'Безопасность', href: url('account.security')}, {label: 'Двухфакторная защита'}]) }}
<div class="mt-4">{{ d.page_header('Включите двухфакторную защиту', 'Займёт две минуты: понадобится телефон с приложением-аутентификатором.') }}</div>
<div class="grid gap-6 lg:grid-cols-2">
    <section class="card">
        <h2 class="text-lg font-semibold">1. Отсканируйте QR-код</h2>
        <p class="mt-1 text-sm text-muted">Откройте Google Authenticator, Яндекс Ключ или другое приложение и добавьте аккаунт по QR-коду.</p>
        <div class="mt-4 flex justify-center rounded-ctl bg-white p-3"><img src="/account/2fa/qr.svg" width="224" height="224" alt="QR-код для приложения-аутентификатора"></div>
        <details class="mt-4 text-sm">
            <summary class="cursor-pointer font-medium text-primary-text">Не получается отсканировать?</summary>
            <p class="mt-2 text-muted">Введите ключ в приложении вручную. Тип ключа: по времени.</p>
            <p class="mt-2 break-all rounded-ctl bg-sunken p-3 font-mono text-base tracking-wider" aria-label="Ключ для ручного ввода">{{ secret_groups|join(' ') }}</p>
        </details>
    </section>
    <section class="card">
        <h2 class="text-lg font-semibold">2. Введите код из приложения</h2>
        <p class="mt-1 text-sm text-muted">Так мы убедимся, что всё настроено верно. Код меняется каждые 30 секунд.</p>
        <form class="mt-4 flex flex-col gap-4" method="post" action="/account/2fa/confirm">
            {{ csrf_field() }}
            {{ f.input('code', 'Шестизначный код', required = true, autocomplete = 'one-time-code', error = errors('code')|first, attrs = {inputmode: 'numeric', pattern: '[0-9 ]*', maxlength: 8, autofocus: ''}) }}
            <div class="flex flex-wrap gap-3">
                {{ f.button('Включить защиту', type = 'submit') }}
                {{ f.button('Отмена', variant = 'ghost', href = url('account.security')) }}
            </div>
        </form>
    </section>
</div>
{% endblock %}
