TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_TEST_CHANNEL=

VKPOSTER_INTERNAL_URL=http://host.docker.internal:8080
SOURCES_READER_SECRET=

# Disabled by default; >=7 compacts old ACKed payloads, never pending records/IDs.
READER_ACK_RETENTION_DAYS=30
READER_REVISION_RETENTION_DAYS=90

# Same Telegram route as publisher. Tunnel uses a private HTTP/SOCKS5 endpoint.
EGRESS_TELEGRAM_MODE=direct
EGRESS_TELEGRAM_PROXY_URL=
